{
  "productName": "Clovy",
  "build": {
    "runner": "../scripts/cargo-clovy-runner.sh",
    "beforeBundleCommand": "bash src-tauri/bundle-clovy-mcp.sh",
    "beforeBuildCommand": "pnpm run browser:prepare -- --release && pnpm run local-transcriber:prepare -- --release && pnpm run computer-use:prepare -- --build-hook && pnpm run build"
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../.tauri-helper/Clovy Video Capture.app": "native/bin/Clovy Video Capture.app",
      "../.tauri-helper/Clovy Audio Capture.app": "native/bin/Clovy Audio Capture.app",
      "../.tauri-helper/Clovy Dictation Helper.app": "native/bin/Clovy Dictation Helper.app",
      "../.tauri-helper/clovy-mcp": "native/bin/clovy-mcp",
      "../.tauri-helper/Clovy Computer Use Driver.app": "native/bin/Clovy Computer Use Driver.app",
      "../resources/agent-browser": "native/agent-browser",
      "resources/agent-skills": "native/agent-skills",
      "../.tauri-helper/Clovy Local Transcriber.app": "native/bin/Clovy Local Transcriber.app"
    },
    "macOS": {
      "bundleName": "Clovy",
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "14.0"
    }
  }
}
