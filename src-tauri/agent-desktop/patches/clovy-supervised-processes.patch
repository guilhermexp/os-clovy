+    let stale = || {
+        AdapterError::new(
+            ErrorCode::StaleRef,
+            "Element identity is unavailable or changed",
+        )
+    };
+    deadline.ensure_remaining()?;
+    let payload = element.1.as_ref().ok_or_else(stale)?;
+    let current = element.0.get_process_id().map_err(|_| stale())?;
+    if current == 0 || current != payload.pid {
+        return Err(stale());
+    }
+    deadline.ensure_remaining()?;
+    let root = crate::private_browser_guard::qualify_expected(
+        ProcessId::new(payload.root_pid),
+        &payload.root_token,
+    )?;
+    deadline.ensure_remaining()?;
+    let target = if payload.pid == payload.root_pid {
+        if payload.token != payload.root_token {
+            return Err(stale());
+        }
+        None
+    } else {
