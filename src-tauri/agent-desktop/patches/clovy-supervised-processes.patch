+#[cfg(target_os = "windows")]
+pub(crate) struct KeyboardReceiver {
+    foreground: isize,
+    focus: isize,
+    foreground_process: crate::private_browser_guard::QualifiedProcess,
+    focus_process: crate::private_browser_guard::QualifiedProcess,
+}
+
+#[cfg(target_os = "windows")]
+pub(crate) struct KeyboardReadAuthority {
+    _element: crate::tree::element::ElementAuthority,
+    _foreground: crate::private_browser_guard::QualifiedProcess,
+    _focus: crate::private_browser_guard::QualifiedProcess,
+}
+
+#[cfg(target_os = "windows")]
+fn keyboard_windows() -> Result<(isize, isize), AdapterError> {
+    use windows_sys::Win32::UI::WindowsAndMessaging::{
+        GUITHREADINFO, GetForegroundWindow, GetGUIThreadInfo,
+    };
+    let foreground = unsafe { GetForegroundWindow() };
+    let mut info = GUITHREADINFO {
+        cbSize: std::mem::size_of::<GUITHREADINFO>() as u32,
+        ..Default::default()
+    };
+    if foreground.is_null()
+        || unsafe { GetGUIThreadInfo(0, &mut info) } == 0
+        || info.hwndFocus.is_null()
+    {
+        return Err(focus_lost_before_delivery());
+    }
+    Ok((foreground as isize, info.hwndFocus as isize))
+}
+
+#[cfg(target_os = "windows")]
+impl KeyboardReceiver {
+    pub(crate) fn capture(element: &UIAElement, deadline: Deadline) -> Result<Self, AdapterError> {
+        let _element = crate::tree::element::qualify_verified(element, deadline)?;
+        if !ensure_keyboard_delivery_ready(element, deadline)?
+            || !target_window_is_foreground(element, deadline)?
+        {
+            return Err(focus_lost_before_delivery());
+        }
+        Self::capture_native(deadline)
+    }
+
+    pub(crate) fn capture_native(deadline: Deadline) -> Result<Self, AdapterError> {
+        deadline.ensure_remaining()?;
+        crate::private_browser_guard::require_context()?;
+        deadline.ensure_remaining()?;
+        let (foreground, focus) = keyboard_windows()?;
+        let owner = crate::system::window::window_identity::live_window_owner;
+        let foreground_pid = owner(foreground as _).ok_or_else(focus_lost_before_delivery)?;
+        let focus_pid = owner(focus as _).ok_or_else(focus_lost_before_delivery)?;
+        let foreground_process = crate::private_browser_guard::qualify(foreground_pid)?;
+        deadline.ensure_remaining()?;
+        let focus_process = crate::private_browser_guard::qualify(focus_pid)?;
+        deadline.ensure_remaining()?;
+        if keyboard_windows()? != (foreground, focus)
+            || owner(foreground as _) != Some(foreground_pid)
+            || owner(focus as _) != Some(focus_pid)
+        {
+            return Err(focus_lost_before_delivery());
+        }
+        Ok(Self {
+            foreground,
+            focus,
+            foreground_process,
+            focus_process,
+        })
+    }
+
+    pub(crate) fn qualify(
+        &self,
+        element: &UIAElement,
+        deadline: Deadline,
+    ) -> Result<KeyboardReadAuthority, AdapterError> {
+        deadline.ensure_remaining()?;
+        crate::input::native_owner::ensure_interactive_desktop()?;
+        let _initial_authority = crate::tree::element::qualify_verified(element, deadline)?;
+        if !ensure_keyboard_delivery_ready(element, deadline)?
+            || !target_window_is_foreground(element, deadline)?
+        {
+            return Err(focus_lost_before_delivery());
+        }
+        let foreground = crate::private_browser_guard::qualify_expected(
+            self.foreground_process.pid(),
+            self.foreground_process.token(),
+        )?;
+        deadline.ensure_remaining()?;
+        let focus = crate::private_browser_guard::qualify_expected(
+            self.focus_process.pid(),
+            self.focus_process.token(),
+        )?;
+        deadline.ensure_remaining()?;
+        let owner = crate::system::window::window_identity::live_window_owner;
+        if keyboard_windows()? != (self.foreground, self.focus)
+            || owner(self.foreground as _) != Some(foreground.pid())
+            || owner(self.focus as _) != Some(focus.pid())
+        {
+            return Err(focus_lost_before_delivery());
+        }
+        let element_authority = crate::tree::element::qualify_verified(element, deadline)?;
+        deadline.ensure_remaining()?;
+        agent_desktop_core::commands::clovy_cancel::ensure()?;
+        deadline.ensure_remaining()?;
+        if !crate::actions::focus::focus_matches_target(element)? {
+            return Err(focus_lost_before_delivery());
+        }
+        deadline.ensure_remaining()?;
+        if keyboard_windows()? != (self.foreground, self.focus)
+            || owner(self.foreground as _) != Some(foreground.pid())
+            || owner(self.focus as _) != Some(focus.pid())
+        {
+            return Err(focus_lost_before_delivery());
+        }
+        deadline.ensure_remaining()?;
+        Ok(KeyboardReadAuthority {
+            _element: element_authority,
+            _foreground: foreground,
+            _focus: focus,
+        })
+    }
+
+    pub(crate) fn qualify_native(
+        &self,
+        deadline: Deadline,
+    ) -> Result<
+        (
+            crate::private_browser_guard::QualifiedProcess,
+            crate::private_browser_guard::QualifiedProcess,
+        ),
+        AdapterError,
+    > {
+        deadline.ensure_remaining()?;
+        crate::input::native_owner::ensure_interactive_desktop()?;
+        let foreground = crate::private_browser_guard::qualify_expected(
+            self.foreground_process.pid(),
+            self.foreground_process.token(),
+        )?;
+        deadline.ensure_remaining()?;
+        let focus = crate::private_browser_guard::qualify_expected(
+            self.focus_process.pid(),
+            self.focus_process.token(),
+        )?;
+        deadline.ensure_remaining()?;
+        agent_desktop_core::commands::clovy_cancel::ensure()?;
+        deadline.ensure_remaining()?;
+        let owner = crate::system::window::window_identity::live_window_owner;
+        if keyboard_windows()? != (self.foreground, self.focus)
+            || owner(self.foreground as _) != Some(foreground.pid())
+            || owner(self.focus as _) != Some(focus.pid())
+        {
+            return Err(focus_lost_before_delivery());
+        }
+        deadline.ensure_remaining()?;
+        Ok((foreground, focus))
+    }
+
+    pub(crate) fn check_native_fast(&self, deadline: Deadline) -> Result<(), AdapterError> {
+        let owner = crate::system::window::window_identity::live_window_owner;
+        if keyboard_windows()? != (self.foreground, self.focus)
+            || owner(self.foreground as _) != Some(self.foreground_process.pid())
+            || owner(self.focus as _) != Some(self.focus_process.pid())
+        {
+            return Err(focus_lost_before_delivery());
+        }
+        deadline.ensure_remaining()
+    }
+}
