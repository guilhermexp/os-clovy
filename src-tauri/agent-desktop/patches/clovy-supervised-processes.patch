+//! Dispatch-time Clovy policy. Upstream intentionally permits secure fields;
+//! the private embedding must check live evidence after resolving the ref.
+use crate::{
+    AccessibilityNode, AdapterError, Deadline, DeliverySemantics, ErrorCode, LiveElement,
+    PlatformAdapter, Point, WindowInfo,
+};
+
+pub(crate) fn supervised() -> bool {
+    std::env::var_os("CLOVY_AGENT_DESKTOP_SUPERVISED").as_deref() == Some(std::ffi::OsStr::new("1"))
+}
+fn blocked(message: &str) -> AdapterError {
+    AdapterError::new(ErrorCode::PolicyDenied,message)
+        .with_details(serde_json::json!({"clovy_code":"computer_use_sensitive_field_blocked","physical_delivery_started":false}))
+        .with_disposition(DeliverySemantics::not_delivered())
+}
+fn sensitive(text: &str) -> bool {
+    let text = text.to_lowercase();
+    [
+        "password",
+        "passcode",
+        "securetextfield",
+        "one-time",
+        "one time",
+        "verification code",
+        "security code",
+        "auth code",
+        "otp",
+        "credit card",
+        "card number",
+        "payment",
+        "billing",
+        "expiration",
+        "expiry",
+        "cardholder",
+        "bank account",
+        "account number",
+        "routing number",
+        "sort code",
+        "iban",
+        "swift code",
+        "cvv",
+        "cvc",
+        "social security",
+        "tax identification",
+        "date of birth",
+        "cc-number",
+        "cc-exp",
+        "cc-csc",
+        "private key",
+        "api key",
+        "access token",
+        "secret",
+        "seed phrase",
+        "recovery phrase",
+        "terminal",
+        "shell prompt",
+    ]
+    .iter()
+    .any(|s| text.contains(s))
+}
+pub(crate) fn guard_live(live: &LiveElement) -> Result<(), AdapterError> {
+    super::clovy_cancel::ensure()?;
+    if !live.states_complete
+        || live.identity.name.is_unknown()
+        || live.identity.description.is_unknown()
+    {
+        return Err(blocked(
+            "The live field security state is incomplete; capture or take over before input",
+        ));
+    }
+    let secure = live
+        .state
+        .states
+        .iter()
+        .any(|s| matches!(s.as_str(), "secure" | "protected" | "password"));
+    let text = format!(
+        "{} {:?} {:?} {:?}",
+        live.state.role,
+        live.identity.name,
+        live.identity.description,
+        live.identity.identifiers.identifiers()
+    );
+    if secure || sensitive(&text) {
+        return Err(blocked(
+            "Computer use cannot operate a credential, code, payment or secret field",
+        ));
+    }
+    Ok(())
+}
+fn intersects(bounds: crate::Rect, point: &Point) -> bool {
+    point.x >= bounds.x
+        && point.y >= bounds.y
+        && point.x < bounds.x + bounds.width
+        && point.y < bounds.y + bounds.height
+}
+fn guard_tree(
+    node: &AccessibilityNode,
+    point: Option<&Point>,
+    visited: &mut usize,
+) -> Result<(), AdapterError> {
+    *visited += 1;
+    if *visited > 20_000 || node.subtree_truncated {
+        return Err(blocked("The live window security inspection is incomplete"));
+    }
+    let states = &node.presentation.states;
+    let secure = states
+        .iter()
+        .any(|s| matches!(s.as_str(), "secure" | "protected" | "password"));
+    let text = format!(
+        "{} {:?} {:?} {:?} {:?} {:?}",
+        node.role,
+        node.identity.name,
+        node.identity.description,
+        node.identity.native_id,
+        node.presentation.descriptors.subrole,
+        node.presentation.descriptors.placeholder
+    );
+    // A document title is content, not a field label. Child controls and
+    // secure states still enforce the policy in a window titled e.g. a
+    // password-policy document.
+    let labelled_sensitive =
+        !matches!(node.role.as_str(), "window" | "application") && sensitive(&text);
+    let relevant = if let Some(point) = point {
+        node.presentation
+            .bounds
+            .is_some_and(|b| intersects(b, point))
+            || (node.presentation.bounds.is_none() && (secure || labelled_sensitive))
+    } else {
+        states.iter().any(|s| s == "focused")
+    };
+    if relevant && (secure || labelled_sensitive) {
+        return Err(blocked(
+            "The input target overlaps or focuses a credential, code, payment or secret field",
+        ));
+    }
+    for child in &node.children {
+        guard_tree(child, point, visited)?;
+    }
+    Ok(())
+}
+pub(crate) fn guard_window(
+    adapter: &dyn PlatformAdapter,
+    window: &WindowInfo,
+    point: Option<&Point>,
+    deadline: Deadline,
+) -> Result<(), AdapterError> {
+    let tree=adapter.get_tree(window,&crate::TreeOptions {max_depth:50,include_bounds:true,..Default::default()},deadline)
+        .map_err(|_|blocked("The exact window's live security state could not be inspected; take over before input"))?;
+    guard_tree(&tree, point, &mut 0)
+}
+pub(crate) fn guard_ref_target(
+    adapter: &dyn PlatformAdapter,
+    entry: &crate::RefEntry,
+    handle: &crate::NativeHandle,
+    deadline: Deadline,
+) -> Result<(), AdapterError> {
+    let id = entry
+        .source
+        .source_window_id
+        .as_deref()
+        .ok_or_else(|| blocked("The live field has no exact window security scope"))?;
+    let expected = WindowInfo {
+        id: id.to_owned(),
+        title: entry.source.source_window_title.clone().unwrap_or_default(),
+        app: entry.source.source_app.clone().unwrap_or_default(),
+        pid: entry.process.pid,
+        process_instance: entry.process.process_instance.clone(),
+        bounds: None,
+        state: Default::default(),
+    };
+    let window = adapter
+        .resolve_window_strict(&expected, deadline)
+        .map_err(|_| blocked("The exact field window changed before security inspection"))?;
+    let live = adapter
+        .get_live_element(handle, deadline)
+        .map_err(|_| blocked("The live field security state could not be inspected"))?;
+    guard_live(&live)?;
+    if let Some(bounds) = live
+        .bounds
+        .filter(|bounds| bounds.width > 0.0 && bounds.height > 0.0)
+    {
+        return guard_window(
+            adapter,
+            &window,
+            Some(&Point {
+                x: bounds.x + bounds.width / 2.0,
+                y: bounds.y + bounds.height / 2.0,
+            }),
+            deadline,
+        );
+    }
+    // A nonspatial semantic target still needs the current full metadata,
+    // including provider placeholders not carried by LiveElement.
+    let tree = adapter
+        .get_tree(
+            &window,
+            &crate::TreeOptions {
+                max_depth: 50,
+                include_bounds: true,
+                ..Default::default()
+            },
+            deadline,
+        )
+        .map_err(|_| blocked("The nonspatial field security metadata is unavailable"))?;
+    let mut node = &tree;
+    for index in &entry.scope.path {
+        node = node
+            .children
+            .get(*index)
+            .ok_or_else(|| blocked("The live field security path changed"))?;
+    }
+    if node.role != entry.identity.role
+        || node.identity.native_id != entry.identity.native_id
+        || node.identity.retained_object != entry.identity.retained_object
+        || (entry.identity.native_id.is_none() && entry.identity.retained_object.is_none())
+    {
+        return Err(blocked(
+            "The nonspatial field identity cannot establish security metadata",
+        ));
+    }
+    let text = format!(
+        "{} {:?} {:?} {:?} {:?}",
+        node.role,
+        node.identity.name,
+        node.identity.description,
+        node.presentation.descriptors.subrole,
+        node.presentation.descriptors.placeholder
+    );
+    if sensitive(&text)
+        || node
+            .presentation
+            .states
+            .iter()
+            .any(|state| state == "secure" || state == "protected")
+    {
+        return Err(blocked(
+            "The live target is a credential, code, payment or secret field",
+        ));
+    }
+    Ok(())
+}
+
+pub(crate) fn guard_drag(
+    adapter: &dyn PlatformAdapter,
+    window: &WindowInfo,
+    from: &Point,
+    to: &Point,
+    deadline: Deadline,
+) -> Result<(), AdapterError> {
+    // The native cursor path can curve slightly. A conservative rectangle also
+    // catches narrow fields between sampled points without repeated AX reads.
+    let margin = 16.0;
+    let region = crate::Rect {
+        x: from.x.min(to.x) - margin,
+        y: from.y.min(to.y) - margin,
+        width: (to.x - from.x).abs() + margin * 2.0,
+        height: (to.y - from.y).abs() + margin * 2.0,
+    };
+    let tree=adapter.get_tree(window,&crate::TreeOptions{max_depth:50,include_bounds:true,..Default::default()},deadline)
+        .map_err(|_|blocked("The exact window's live security state could not be inspected; take over before input"))?;
+    fn visit(
+        node: &AccessibilityNode,
+        region: crate::Rect,
+        count: &mut usize,
+    ) -> Result<(), AdapterError> {
+        *count += 1;
+        if *count > 20_000 || node.subtree_truncated {
+            return Err(blocked("The live window security inspection is incomplete"));
+        }
+        let secure = node
+            .presentation
+            .states
+            .iter()
+            .any(|s| matches!(s.as_str(), "secure" | "protected" | "password"));
+        let text = format!(
+            "{} {:?} {:?} {:?} {:?} {:?}",
+            node.role,
+            node.identity.name,
+            node.identity.description,
+            node.identity.native_id,
+            node.presentation.descriptors.subrole,
+            node.presentation.descriptors.placeholder
+        );
+        let overlap = node.presentation.bounds.is_none_or(|b| {
+            b.x < region.x + region.width
+                && b.x + b.width > region.x
+                && b.y < region.y + region.height
+                && b.y + b.height > region.y
+        });
+        let labelled_sensitive =
+            !matches!(node.role.as_str(), "window" | "application") && sensitive(&text);
+        if overlap && (secure || labelled_sensitive) {
+            return Err(blocked(
+                "The drag path overlaps a credential, code, payment or secret field",
+            ));
+        }
+        for child in &node.children {
+            visit(child, region, count)?;
+        }
+        Ok(())
+    }
+    visit(&tree, region, &mut 0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn newly_secure_overlay_and_incomplete_evidence_are_refused() {
+        let mut tree:AccessibilityNode=serde_json::from_value(serde_json::json!({"role":"window","name":"Password policy notes","children":[{"role":"textfield","states":["secure","focused"],"bounds":{"x":20,"y":20,"width":100,"height":20}}]})).unwrap();
+        assert!(guard_tree(&tree, Some(&Point { x: 40.0, y: 30.0 }), &mut 0).is_err());
+        assert!(guard_tree(&tree, None, &mut 0).is_err());
+        assert!(guard_tree(&tree, Some(&Point { x: 200.0, y: 200.0 }), &mut 0).is_ok());
+        tree.subtree_truncated = true;
+        assert!(guard_tree(&tree, None, &mut 0).is_err());
+    }
+}
