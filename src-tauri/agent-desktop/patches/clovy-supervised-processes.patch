 };
 use agent_desktop_core::{Deadline, ErrorCode};

+#[test]
+fn a_policy_refusal_aborts_the_walk_before_later_evidence() {
+    use std::cell::Cell;
+    struct RefusingTree {
+        inner: FakeTree,
+        later_read: Cell<bool>,
+    }
+    impl TreeSource for RefusingTree {
+        type Node = i32;
+        fn bind(&self, node: &i32) -> Result<i32, AdapterError> {
+            self.inner.bind(node)
+        }
+        fn first_child(&self, node: &i32) -> Result<i32, UiaFailure> {
+            self.inner.first_child(node)
+        }
+        fn next_sibling(&self, node: &i32) -> Result<i32, UiaFailure> {
+            self.inner.next_sibling(node)
+        }
+        fn identity(&self, node: &i32) -> NodeKey {
+            self.inner.identity(node)
+        }
+        fn same_element(&self, a: &i32, b: &i32) -> bool {
+            self.inner.same_element(a, b)
+        }
+        fn evidence(
+            &self,
+            node: &i32,
+        ) -> Result<(ElementProperties, LocatorEvidence, u64), AdapterError> {
+            if *node == 2 {
+                return Err(AdapterError::new(ErrorCode::PolicyDenied, "Refused"));
+            }
+            if *node == 3 {
+                self.later_read.set(true);
+            }
+            self.inner.evidence(node)
+        }
+        fn is_web_wrapper(&self, node: &i32, properties: &ElementProperties) -> bool {
+            self.inner.is_web_wrapper(node, properties)
+        }
+    }
+    let tree = RefusingTree {
+        inner: FakeTree::default().with_children(1, &[2, 3]),
+        later_read: Cell::new(false),
+    };
+    let mut walk = TreeWalk::new(&tree, budget(10));
+    walk.visit(1, 0, 0);
+    assert_eq!(walk.ancestor_depth(), 0);
+    let error = match walk.finish() {
+        Err(error) => error,
+        Ok(_) => panic!("policy refusal must fail the walk"),
+    };
+    assert_eq!(error.code, ErrorCode::PolicyDenied);
+    assert!(!tree.later_read.get());
+}
