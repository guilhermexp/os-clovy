+fn kernel_executable(pid: i32) -> Result<String, AdapterError> {
+    let mut buffer = vec![0u8; 4096];
+    let length =
+        unsafe { libc::proc_pidpath(pid, buffer.as_mut_ptr().cast(), buffer.len() as u32) };
+    if length <= 0 || length as usize > buffer.len() {
+        return Err(AdapterError::internal(
+            "The launched executable path could not be verified",
+        ));
+    }
+    buffer.truncate(length as usize);
+    if buffer.last() == Some(&0) {
+        buffer.pop();
+    }
+    String::from_utf8(buffer)
+        .map_err(|_| AdapterError::internal("The launched executable path is not UTF-8"))
+}
+fn verified_executable_path(native: &str, kernel: &str) -> Result<(), AdapterError> {
+    if !std::path::Path::new(native).is_absolute()
+        || !std::path::Path::new(kernel).is_absolute()
+        || std::fs::canonicalize(native)
+            .ok()
+            .zip(std::fs::canonicalize(kernel).ok())
+            .is_none_or(|(native, kernel)| native != kernel)
+    {
+        return Err(AdapterError::new(
+            ErrorCode::AppUnresponsive,
+            "The native application and kernel executable paths do not identify the same file",
+        ));
+    }
+    Ok(())
+}
+
+fn capture_authority(
+    result: &crate::system::launch_callback_result::LaunchCallbackResult,
+    identity: crate::system::process::process_identity::ProcessIdentity,
+) -> Result<agent_desktop_core::system::launch_result::LaunchIdentity, AdapterError> {
+    let native_path = copy_identity_text(
+        result.executable_path,
+        result.executable_path_len,
+        "executable path",
+    )?;
+    let bundle = copy_identity_text(result.bundle_id, result.bundle_id_len, "bundle identifier")?;
+    if bundle.trim().is_empty() || !std::path::Path::new(&native_path).is_absolute() {
+        return Err(AdapterError::internal(
+            "Native launch authority is incomplete",
+        ));
+    }
+    // Kernel path is representation only, after the native object's authority
+    // and birth were captured. It must denote that object's executable, and
+    // the birth and object liveness must still match after all reads.
+    let kernel_path = kernel_executable(result.pid)?;
+    verified_executable_path(&native_path, &kernel_path)?;
+    if !identity.still_matches()?
+        || unsafe { agent_desktop_running_application_is_live(result.application, result.pid) } == 0
+        || !identity.still_matches()?
+    {
+        return Err(AdapterError::new(
+            ErrorCode::AppUnresponsive,
+            "The native launch authority changed before its receipt was captured",
+        ));
+    }
+    Ok(agent_desktop_core::system::launch_result::LaunchIdentity {
+        executable_path: kernel_path,
+        process_creation_time: identity.creation_micros()?,
+        bundle_id: bundle,
+    })
+}
