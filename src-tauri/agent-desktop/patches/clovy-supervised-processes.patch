@@ -0,0 +1,119 @@
+//! Host-provided browser identity, evaluated afresh at each native boundary.
+use agent_desktop_core::{AdapterError, ErrorCode};
+use std::{
+    path::{Path, PathBuf},
+    sync::OnceLock,
+};
+
+fn denied() -> AdapterError {
+    AdapterError::new(
+        ErrorCode::PolicyDenied,
+        "This target cannot be controlled here",
+    )
+    .with_suggestion("Use Browser use or take over manually.")
+}
+
+fn runtime() -> Result<&'static crate::computer_use_owned_runtime::OwnedBrowserRuntime, AdapterError>
+{
+    static RUNTIME: OnceLock<Option<crate::computer_use_owned_runtime::OwnedBrowserRuntime>> =
+        OnceLock::new();
+    RUNTIME
+        .get_or_init(|| {
+            let namespace =
+                PathBuf::from(std::env::var_os("CLOVY_COMPUTER_USE_BROWSER_NAMESPACE")?);
+            let image = PathBuf::from(std::env::var_os("CLOVY_COMPUTER_USE_BROWSER_IMAGE")?);
+            if !namespace.is_absolute() || !image.is_absolute() {
+                return None;
+            }
+            Some(crate::computer_use_owned_runtime::OwnedBrowserRuntime::new(
+                namespace, image,
+            ))
+        })
+        .as_ref()
+        .ok_or_else(denied)
+}
+
+pub(crate) fn qualify(path: &Path) -> Result<(), AdapterError> {
+    match runtime()?.owns(path) {
+        Ok(false) => Ok(()),
+        Ok(true) | Err(_) => Err(denied()),
+    }
+}
+
+pub(crate) fn qualify_pid(
+    pid: i32,
+    expected: Option<&str>,
+) -> Result<Option<String>, AdapterError> {
+    let identity = super::process::process_identity::ProcessIdentity::capture(pid)
+        .map_err(|_| denied())?
+        .ok_or_else(|| AdapterError::stale_ref_because("Window owner is unavailable"))?;
+    let token = identity.token();
+    if expected.is_some_and(|expected| expected != token) {
+        return Err(AdapterError::stale_ref_because(
+            "Window owner generation changed",
+        ));
+    }
+    let image = super::launch_completion::kernel_executable(pid).map_err(|_| denied())?;
+    let owned = runtime()?.owns(Path::new(&image)).map_err(|_| denied())?;
+    let current = super::launch_completion::kernel_executable(pid).map_err(|_| denied())?;
+    if current != image || !identity.still_matches().map_err(|_| denied())? {
+        return Err(AdapterError::stale_ref_because(
+            "Window owner generation changed",
+        ));
+    }
+    Ok((!owned).then_some(token))
+}
+
+pub(crate) fn require_pid(pid: i32, expected: Option<&str>) -> Result<String, AdapterError> {
+    qualify_pid(pid, expected)?.ok_or_else(denied)
+}
+
+// Only the native launch bridge calls this; paths and birth tokens are never
+// supplied by tool arguments. Null and invalid inputs refuse the operation.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn agent_desktop_qualify_launch_image(
+    path: *const std::ffi::c_char,
+    expected_pid: i32,
+    expected_instance: *const std::ffi::c_char,
+) -> u8 {
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::fs::MetadataExt;
+    if agent_desktop_core::commands::clovy_cancel::ensure().is_err() {
+        return 2;
+    }
+    std::panic::catch_unwind(|| {
+        if path.is_null() || expected_pid < 0 {
+            return false;
+        }
+        let bytes = unsafe { std::ffi::CStr::from_ptr(path) }.to_bytes();
+        let selected = Path::new(std::ffi::OsStr::from_bytes(bytes));
+        if qualify(selected).is_err() {
+            return false;
+        }
+        if expected_pid == 0 {
+            return true;
+        }
+        if expected_instance.is_null() {
+            return false;
+        }
+        let Ok(instance) = unsafe { std::ffi::CStr::from_ptr(expected_instance) }.to_str() else {
+            return false;
+        };
+        let Ok(identity) = super::launch_completion::identity_for_existing(expected_pid, instance)
+        else {
+            return false;
+        };
+        let existing = Path::new(&identity.executable_path);
+        if qualify(existing).is_err() {
+            return false;
+        }
+        let (Ok(a), Ok(b)) = (std::fs::metadata(selected), std::fs::metadata(existing)) else {
+            return false;
+        };
+        a.dev() == b.dev()
+            && a.ino() == b.ino()
+            && super::process::process_identity::matches_instance(expected_pid, instance)
+                .unwrap_or(false)
+    })
+    .unwrap_or(false) as u8
+}
