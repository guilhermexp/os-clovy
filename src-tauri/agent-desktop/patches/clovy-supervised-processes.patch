+//! Private host configuration and per-use process image qualification.
+use agent_desktop_core::{AdapterError, ErrorCode, ProcessId};
+
+fn denied() -> AdapterError {
+    AdapterError::new(
+        ErrorCode::PolicyDenied,
+        "This target cannot be controlled here",
+    )
+    .with_suggestion("Use Browser use or take over manually.")
+}
+
+fn stale() -> AdapterError {
+    AdapterError::new(
+        ErrorCode::StaleRef,
+        "The target process identity is unavailable or changed",
+    )
+}
+
+#[cfg(target_os = "windows")]
+fn runtime() -> Result<&'static crate::computer_use_owned_runtime::OwnedBrowserRuntime, AdapterError>
+{
+    use crate::computer_use_owned_runtime::OwnedBrowserRuntime;
+    use std::{path::PathBuf, sync::OnceLock};
+    static RUNTIME: OnceLock<Option<OwnedBrowserRuntime>> = OnceLock::new();
+    RUNTIME
+        .get_or_init(|| {
+            let namespace =
+                PathBuf::from(std::env::var_os("CLOVY_COMPUTER_USE_BROWSER_NAMESPACE")?);
+            let image = PathBuf::from(std::env::var_os("CLOVY_COMPUTER_USE_BROWSER_IMAGE")?);
+            if !namespace.is_absolute() || !image.is_absolute() {
+                return None;
+            }
+            Some(OwnedBrowserRuntime::new(namespace, image))
+        })
+        .as_ref()
+        .ok_or_else(denied)
+}
+
+#[cfg(target_os = "windows")]
+pub(crate) fn require_context() -> Result<(), AdapterError> {
+    runtime().map(|_| ())
+}
+
+#[cfg(not(target_os = "windows"))]
+pub(crate) fn require_context() -> Result<(), AdapterError> {
+    Err(denied())
+}
+
+/// Read the executable and creation time from one process object. An unknown
+/// identity or private image is never evidence authorizing a read.
+pub(crate) struct QualifiedProcess {
+    #[cfg(target_os = "windows")]
+    _handle: ProcessHandle,
+    token: String,
+    pid: ProcessId,
+}
+
+impl QualifiedProcess {
+    pub(crate) fn token(&self) -> &str {
+        &self.token
+    }
+    pub(crate) fn pid(&self) -> ProcessId {
+        self.pid
+    }
+}
+
+#[cfg(target_os = "windows")]
+struct ProcessHandle(windows_sys::Win32::Foundation::HANDLE);
+
+#[cfg(target_os = "windows")]
+impl Drop for ProcessHandle {
+    fn drop(&mut self) {
+        unsafe { windows_sys::Win32::Foundation::CloseHandle(self.0) };
+    }
+}
+
+pub(crate) struct QualifiedWindowProcesses {
+    _target: QualifiedProcess,
+    _owner: Option<QualifiedProcess>,
+}
+
+impl QualifiedWindowProcesses {
+    pub(crate) fn target_pid(&self) -> ProcessId {
+        self._target.pid()
+    }
+
+    pub(crate) fn target_token(&self) -> &str {
+        self._target.token()
+    }
+
+    pub(crate) fn owner_token(&self) -> &str {
+        self._owner.as_ref().unwrap_or(&self._target).token()
+    }
+
+    pub(crate) fn owner_pid(&self) -> ProcessId {
+        self._owner.as_ref().unwrap_or(&self._target).pid()
+    }
+}
+
+#[cfg(target_os = "windows")]
+pub(crate) fn qualify(pid: ProcessId) -> Result<QualifiedProcess, AdapterError> {
+    qualify_inner(pid, None)
+}
+
+#[cfg(target_os = "windows")]
+fn qualify_inner(pid: ProcessId, expected: Option<&str>) -> Result<QualifiedProcess, AdapterError> {
+    use std::{os::windows::ffi::OsStringExt, path::PathBuf};
+    use windows_sys::Win32::Foundation::{
+        ERROR_INSUFFICIENT_BUFFER, ERROR_INVALID_PARAMETER, FILETIME, GetLastError,
+    };
+    use windows_sys::Win32::System::Threading::{
+        GetExitCodeProcess, GetProcessTimes, OpenProcess, PROCESS_NAME_WIN32,
+        PROCESS_QUERY_LIMITED_INFORMATION, QueryFullProcessImageNameW,
+    };
+    let runtime = runtime()?;
+    let raw = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, u32::from(pid)) };
+    if raw.is_null() {
+        return Err(if unsafe { GetLastError() } == ERROR_INVALID_PARAMETER {
+            stale()
+        } else {
+            denied()
+        });
+    }
+    let handle = ProcessHandle(raw);
+    let mut exit_code = 0u32;
+    if unsafe { GetExitCodeProcess(handle.0, &mut exit_code) } == 0 {
+        return Err(denied());
+    }
+    if exit_code != windows_sys::Win32::Foundation::STILL_ACTIVE as u32 {
+        return Err(stale());
+    }
+    let mut created = FILETIME::default();
+    let mut exit = FILETIME::default();
+    let mut kernel = FILETIME::default();
+    let mut user = FILETIME::default();
+    if unsafe { GetProcessTimes(handle.0, &mut created, &mut exit, &mut kernel, &mut user) } == 0 {
+        return Err(stale());
+    }
+    let ticks = (u64::from(created.dwHighDateTime) << 32) | u64::from(created.dwLowDateTime);
+    if ticks == 0 {
+        return Err(stale());
+    }
+    let token = format!(
+        "windows-proc-v1:{}:{}",
+        ticks / 10_000_000,
+        ticks % 10_000_000
+    );
+    if expected.is_some_and(|expected| expected != token) {
+        return Err(stale());
+    }
+    let mut small = [0u16; 512];
+    let mut len = small.len() as u32;
+    let ok = unsafe {
+        QueryFullProcessImageNameW(handle.0, PROCESS_NAME_WIN32, small.as_mut_ptr(), &mut len)
+    };
+    let path = if ok != 0 {
+        PathBuf::from(std::ffi::OsString::from_wide(&small[..len as usize]))
+    } else {
+        if unsafe { GetLastError() } != ERROR_INSUFFICIENT_BUFFER {
+            return Err(denied());
+        }
+        let mut large = vec![0u16; 32768];
+        len = large.len() as u32;
+        if unsafe {
+            QueryFullProcessImageNameW(handle.0, PROCESS_NAME_WIN32, large.as_mut_ptr(), &mut len)
+        } == 0
+        {
+            return Err(denied());
+        }
+        PathBuf::from(std::ffi::OsString::from_wide(&large[..len as usize]))
+    };
+    if !matches!(runtime.owns(&path), Ok(false)) {
+        return Err(denied());
+    }
+    Ok(QualifiedProcess {
+        _handle: handle,
+        token,
+        pid,
+    })
+}
+
+#[cfg(not(target_os = "windows"))]
+pub(crate) fn qualify(_pid: ProcessId) -> Result<QualifiedProcess, AdapterError> {
+    Err(denied())
+}
+
+#[cfg(target_os = "windows")]
+pub(crate) fn qualify_expected(
+    pid: ProcessId,
+    expected: &str,
+) -> Result<QualifiedProcess, AdapterError> {
+    qualify_inner(pid, Some(expected))
+}
+
+#[cfg(not(target_os = "windows"))]
+pub(crate) fn qualify_expected(
+    _pid: ProcessId,
+    _expected: &str,
+) -> Result<QualifiedProcess, AdapterError> {
+    Err(denied())
+}
+
+pub(crate) fn qualify_window_processes(
+    owner: ProcessId,
+    pid: ProcessId,
+    expected: &str,
+    deadline: agent_desktop_core::Deadline,
+) -> Result<QualifiedWindowProcesses, AdapterError> {
+    deadline.ensure_remaining()?;
+    let target = qualify_expected(pid, expected)?;
+    deadline.ensure_remaining()?;
+    let owner = if owner == pid {
+        None
+    } else {
+        Some(qualify(owner)?)
+    };
+    deadline.ensure_remaining()?;
+    Ok(QualifiedWindowProcesses {
+        _target: target,
+        _owner: owner,
+    })
+}
