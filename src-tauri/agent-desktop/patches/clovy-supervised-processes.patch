+#[test]
+fn supervised_ref_guard_retains_preparatory_focus() {
+    let root = std::env::temp_dir().join(format!("clovy-f17-{}", std::process::id()));
+    std::fs::create_dir(&root).unwrap();
+    let output = std::process::Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--ignored",
+            "--exact",
+            "ref_action::ref_action_wait::focus_order_tests::supervised_ref_guard_child",
+        ])
+        .env("CLOVY_AGENT_DESKTOP_SUPERVISED", "1")
+        .env("CLOVY_AGENT_DESKTOP_CANCEL_FILE", root.join("cancel"))
+        .env(
+            "CLOVY_AGENT_DESKTOP_CANCEL_ACK_FILE",
+            root.join("cancel-ack"),
+        )
+        .output()
+        .unwrap();
+    std::fs::remove_dir(root).unwrap();
+    assert!(
+        output.status.success(),
+        "{}\n{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+#[test]
+#[ignore = "runs only in an isolated supervised subprocess"]
+fn supervised_ref_guard_child() {
+    let focused = adapter(false, true);
+    let error = execute_action(&focused, true, 2_000, Action::DoubleClick).unwrap_err();
+    assert!(focused.focused.load(Ordering::SeqCst));
+    assert_eq!(focused.dispatched.load(Ordering::SeqCst), 0);
+    assert_eq!(error.code, crate::ErrorCode::PolicyDenied, "{error:?}");
+    assert_eq!(error.disposition.retry(), crate::RetryDisposition::Unsafe);
+    let details = error.details.unwrap();
+    assert_eq!(details["preparatory_effects"]["focus"]["confirmed"], true);
+    assert_eq!(
+        details["native_disposition"],
+        serde_json::json!(crate::DeliverySemantics::not_delivered())
+    );
+
+    let untouched = adapter(false, true);
+    untouched.focused.store(true, Ordering::SeqCst);
+    let error = execute_action(&untouched, false, 2_000, Action::Click).unwrap_err();
+    assert_eq!(error.code, crate::ErrorCode::PolicyDenied, "{error:?}");
+    assert_eq!(error.disposition.retry(), crate::RetryDisposition::Safe);
+    assert_eq!(untouched.dispatched.load(Ordering::SeqCst), 0);
+    assert!(
+        error
+            .details
+            .as_ref()
+            .and_then(|v| v.get("preparatory_effects"))
+            .is_none()
+    );
+
+    let adapter = adapter(false, false);
+    let error = execute_action(&adapter, true, 150, Action::DoubleClick).unwrap_err();
+    assert!(!adapter.focused.load(Ordering::SeqCst));
+    assert_eq!(adapter.dispatched.load(Ordering::SeqCst), 0);
+    assert!(
+        error
+            .details
+            .as_ref()
+            .and_then(|v| v.get("preparatory_effects"))
+            .is_none()
+    );
+}
