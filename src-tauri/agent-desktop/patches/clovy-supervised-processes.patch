+    deadline.ensure_remaining()?;
+    if element.0.get_process_id().map_err(|_| stale())? != current {
+        return Err(stale());
+    }
+    deadline.ensure_remaining()?;
+    Ok(ElementAuthority {
+        _root: root,
+        _target: target,
+    })
