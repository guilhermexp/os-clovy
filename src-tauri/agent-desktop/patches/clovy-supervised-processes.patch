+    #[test]
+    fn native_launch_path_requires_real_same_file_and_keeps_kernel_representation() {
+        let root = std::env::var_os("CLOVY_AUTHORITY_PROOF_ROOT")
+            .map(std::path::PathBuf::from)
+            .unwrap_or_else(std::env::temp_dir)
+            .join(format!(
+                "clovy-launch-authority-{}-{}",
+                std::process::id(),
+                std::time::SystemTime::now()
+                    .duration_since(std::time::UNIX_EPOCH)
+                    .unwrap()
+                    .as_nanos()
+            ));
+        std::fs::create_dir_all(&root).unwrap();
+        let native = root.join("A");
+        let alias = root.join("alias-A");
+        let other = root.join("B");
+        std::fs::write(&native, b"synthetic A").unwrap();
+        std::fs::write(&other, b"synthetic B").unwrap();
+        std::os::unix::fs::symlink(&native, &alias).unwrap();
+        assert!(
+            verified_executable_path(alias.to_str().unwrap(), native.to_str().unwrap()).is_ok()
+        );
+        assert!(
+            verified_executable_path(native.to_str().unwrap(), alias.to_str().unwrap()).is_ok()
+        );
+        assert!(
+            verified_executable_path(native.to_str().unwrap(), other.to_str().unwrap()).is_err()
+        );
+        assert!(
+            verified_executable_path(
+                native.to_str().unwrap(),
+                root.join("missing").to_str().unwrap()
+            )
+            .is_err()
+        );
+        assert!(verified_executable_path("relative-A", native.to_str().unwrap()).is_err());
+    }
+}
