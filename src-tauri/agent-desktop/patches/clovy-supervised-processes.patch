+pub(crate) trait Observations {
+    type Desktop: Clone + PartialEq;
+    fn desktop(&mut self) -> Result<Self::Desktop, AdapterError>;
+    fn down(&mut self, key: u16) -> Result<bool, AdapterError>;
+}
+struct Owner<S: Observations> {
+    state: S,
+    desktop: S::Desktop,
+    keys: Vec<u16>,
+}
+fn unsent(message: &str) -> AdapterError {
+    AdapterError::new(ErrorCode::ActionFailed, message)
+        .with_disposition(DeliverySemantics::not_delivered())
+}
+impl<S: Observations> Owner<S> {
+    fn begin(mut state: S, keys: Vec<u16>) -> Result<Self, AdapterError> {
+        let desktop = state.desktop()?;
+        let mut unique = Vec::new();
+        for key in keys {
+            if unique.contains(&key) {
+                continue;
+            }
+            if state.down(key)? {
+                return Err(unsent(
+                    "An input key or button is already held; take over before this action",
+                ));
+            }
+            unique.push(key);
+        }
+        if state.desktop()? != desktop {
+            return Err(unsent("The active input desktop changed before input"));
+        }
+        Ok(Self {
+            state,
+            desktop,
+            keys: unique,
+        })
+    }
+    fn released(&mut self) -> Result<bool, AdapterError> {
+        if self.state.desktop()? != self.desktop {
+            return Err(unsent(
+                "The input desktop changed during release observation",
+            ));
+        }
+        let mut held = Vec::new();
+        for key in &self.keys {
+            if self.state.down(*key)? {
+                held.push(*key);
+            }
+        }
+        if self.state.desktop()? != self.desktop {
+            return Err(unsent(
+                "The input desktop changed during release observation",
+            ));
+        }
+        Ok(held.is_empty())
+    }
+    fn finish(
+        mut self,
+        result: Result<(), AdapterError>,
+        acknowledge: impl FnOnce(bool),
+    ) -> Result<(), AdapterError> {
+        let limit = Instant::now() + Duration::from_millis(40);
+        let mut previous_clear = false;
+        let released = loop {
+            if Instant::now() >= limit {
+                break Err(unsent("The owned input release observation expired"));
+            }
+            let observation = self.released();
+            if Instant::now() >= limit {
+                break Err(unsent("The owned input release observation expired"));
+            }
+            match observation {
+                Ok(true) if previous_clear => break Ok(()),
+                Ok(clear) => previous_clear = clear,
+                Err(error) => break Err(error),
+            }
+            if Instant::now() >= limit {
+                break Err(unsent("Owned input was not observed released"));
+            }
+            std::thread::sleep(Duration::from_millis(2));
+        };
+        acknowledge(released.is_ok());
+        match released {
+            Ok(()) => result,
+            Err(observation) => {
+                let mut error = result.err().unwrap_or_else(|| {
+                    AdapterError::new(
+                        ErrorCode::ActionFailed,
+                        "Native input release could not be verified",
+                    )
+                });
+                let mut details = error
+                    .details
+                    .take()
+                    .unwrap_or_else(|| serde_json::json!({}));
+                if let Some(map) = details.as_object_mut() {
+                    if let Some(domain) = observation
+                        .details
+                        .as_ref()
+                        .and_then(|details| details.get("clovy_code"))
+                    {
+                        map.insert("clovy_code".into(), domain.clone());
+                    }
+                    map.insert("release_verified".into(), false.into());
+                    map.insert(
+                        "release_observation_error".into(),
+                        observation.message.into(),
+                    );
+                }
+                Err(error
+                    .with_details(details)
+                    .with_disposition(DeliverySemantics::uncertain()))
+            }
+        }
+    }
+}
