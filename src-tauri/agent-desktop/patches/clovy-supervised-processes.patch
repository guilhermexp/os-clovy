+#[test]
+fn window_key_consumer_rejects_reused_handle_inside_lease_before_any_effect() {
+    for (headed, change) in [false, true].into_iter().flat_map(|headed| {
+        [Change::ReusedBeforeResolve, Change::ReusedAtLease]
+            .into_iter()
+            .map(move |change| (headed, change))
+    }) {
+        let world = World::new(change);
+        let context = CommandContext::default().with_headed(headed);
+        let result = press_window(
+            &serde_json::to_string(&window()).unwrap(),
+            "escape".into(),
+            &world,
+            &context,
+        );
+        assert_eq!(world.focuses.load(Ordering::SeqCst), 0);
+        assert_eq!(world.inputs.load(Ordering::SeqCst), 0);
+        assert!(!world.leased.load(Ordering::SeqCst));
+        let error = result.unwrap_err();
+        assert_eq!(error.code(), "STALE_REF");
+        match error {
+            AppError::Adapter(error) => {
+                assert_eq!(error.disposition, DeliverySemantics::not_delivered())
+            }
+            other => panic!("{other}"),
+        }
+    }
+}
+#[test]
+fn window_key_consumer_preserves_stable_authority_in_both_modalities() {
+    for headed in [false, true] {
+        let world = World::new(Change::Stable);
+        let context = CommandContext::default().with_headed(headed);
+        let result = press_window(
+            &serde_json::to_string(&window()).unwrap(),
+            "ctrl+f".into(),
+            &world,
+            &context,
+        )
+        .unwrap();
+        assert_eq!(world.focuses.load(Ordering::SeqCst), usize::from(headed));
+        assert_eq!(world.inputs.load(Ordering::SeqCst), 1);
+        assert_eq!(result["disposition"]["retry"], "unsafe");
+        assert!(!world.leased.load(Ordering::SeqCst));
+    }
+}
+fn gesture(world: &World, dragging: bool) -> Result<Value, AppError> {
+    let encoded = serde_json::to_string(&window()).unwrap();
+    let context = CommandContext::default().with_headed(true);
+    if dragging {
+        drag(
+            &encoded,
+            vec![],
+            (10.0, 10.0),
+            (20.0, 20.0),
+            world,
+            &context,
+        )
+    } else {
+        mouse(
+            &encoded,
+            MouseEvent {
+                point: Point { x: 10.0, y: 10.0 },
+                button: crate::MouseButton::Left,
+                kind: MouseEventKind::Click { count: 1 },
+                modifiers: vec![],
+            },
+            world,
+            &context,
+        )
+    }
+}
+
+fn assert_after_focus(change: Change, dragging: bool) {
+    let world = World::new(change);
+    let error = gesture(&world, dragging).unwrap_err();
+    assert_eq!(world.focuses.load(Ordering::SeqCst), 1);
+    assert_eq!(world.inputs.load(Ordering::SeqCst), 0);
+    match error {
+        AppError::Adapter(error) => {
+            assert_eq!(error.disposition.retry(), crate::RetryDisposition::Unsafe);
+            let details = error.details.unwrap();
+            assert_eq!(
+                details["native_disposition"],
+                json!(DeliverySemantics::not_delivered())
+            );
+            let focus = &details["preparatory_effects"]["focus"];
+            assert_eq!(focus["attempted"], true);
+            assert_eq!(focus["confirmed"], true);
+            assert_eq!(focus["pid"], 42);
+            assert_eq!(
+                details["preparatory_effects"]["target_input"]["attempted"],
+                false
+            );
+            if matches!(change, Change::ResolveAfterFocus) {
+                assert_eq!(details["clovy_code"], "fixture_resolve_lost");
+            }
+        }
+        other => panic!("{other}"),
+    }
+}
+#[test]
+fn guard_or_resolve_failure_after_focus_keeps_partial_delivery_and_never_sends_mouse_or_drag() {
+    for dragging in [false, true] {
+        for change in [Change::SecureAfterFocus, Change::ResolveAfterFocus] {
+            assert_after_focus(change, dragging);
+        }
+    }
+}
