diff --git a/crates/windows/src/input/mouse/window_scope.rs b/crates/windows/src/input/mouse/window_scope.rs
new file mode 100644
index 0000000..11fccf5
--- /dev/null
+++ b/crates/windows/src/input/mouse/window_scope.rs
@@ -0,0 +1,309 @@
+use super::mouse_send::{MouseInputEvent, post_mouse_inputs};
+use crate::private_browser_guard::QualifiedWindowProcesses;
+use agent_desktop_core::{AdapterError, Deadline, ErrorCode, Point, ProcessId, WindowInfo};
+use windows_sys::Win32::Foundation::{HWND, POINT};
+use windows_sys::Win32::UI::WindowsAndMessaging::{
+    GA_ROOT, GUITHREADINFO, GetAncestor, GetCursorPos, GetForegroundWindow, GetGUIThreadInfo,
+    GetWindowThreadProcessId, WindowFromPoint,
+};
+
+#[derive(PartialEq, Eq)]
+struct NativeReceivers {
+    hit: isize,
+    hit_pid: ProcessId,
+    foreground_capture: isize,
+    hit_capture: isize,
+    foreground_capture_pid: Option<ProcessId>,
+    hit_capture_pid: Option<ProcessId>,
+}
+
+fn refused() -> AdapterError {
+    AdapterError::new(
+        ErrorCode::StaleRef,
+        "Pointer receiver is unavailable or changed",
+    )
+}
+
+fn capture_for_thread(thread: u32) -> Result<HWND, AdapterError> {
+    let mut info = GUITHREADINFO {
+        cbSize: std::mem::size_of::<GUITHREADINFO>() as u32,
+        ..Default::default()
+    };
+    if thread == 0 || unsafe { GetGUIThreadInfo(thread, &mut info) } == 0 {
+        return Err(refused());
+    }
+    Ok(info.hwndCapture)
+}
+
+fn native_receivers(point: POINT, target: HWND) -> Result<NativeReceivers, AdapterError> {
+    let hit = unsafe { WindowFromPoint(point) };
+    let foreground = unsafe { GetForegroundWindow() };
+    if hit.is_null() || foreground != target || unsafe { GetAncestor(hit, GA_ROOT) } != target {
+        return Err(refused());
+    }
+    let owner = crate::system::window::window_identity::live_window_owner;
+    let hit_pid = owner(hit).ok_or_else(refused)?;
+    let foreground_thread = unsafe { GetWindowThreadProcessId(foreground, std::ptr::null_mut()) };
+    let hit_thread = unsafe { GetWindowThreadProcessId(hit, std::ptr::null_mut()) };
+    let foreground_capture = capture_for_thread(foreground_thread)?;
+    let hit_capture = if hit_thread == foreground_thread {
+        foreground_capture
+    } else {
+        capture_for_thread(hit_thread)?
+    };
+    let capture_pid = |handle: HWND| -> Result<Option<ProcessId>, AdapterError> {
+        if handle.is_null() {
+            return Ok(None);
+        }
+        if unsafe { GetAncestor(handle, GA_ROOT) } != target {
+            return Err(refused());
+        }
+        Ok(Some(owner(handle).ok_or_else(refused)?))
+    };
+    Ok(NativeReceivers {
+        hit: hit as isize,
+        hit_pid,
+        foreground_capture: foreground_capture as isize,
+        hit_capture: hit_capture as isize,
+        foreground_capture_pid: capture_pid(foreground_capture)?,
+        hit_capture_pid: capture_pid(hit_capture)?,
+    })
+}
+
+fn cursor_position() -> Result<POINT, AdapterError> {
+    let mut point = POINT { x: 0, y: 0 };
+    if unsafe { GetCursorPos(&mut point) } == 0 {
+        return Err(refused());
+    }
+    Ok(point)
+}
+
+/// The host-supplied window and the owner generation captured for this single
+/// operation. It is never populated from model arguments or a later lookup.
+pub(crate) struct WindowScope<'a> {
+    window: &'a WindowInfo,
+    source: ScopeSource<'a>,
+    expected: QualifiedWindowProcesses,
+    deadline: Deadline,
+}
+
+#[derive(Clone, Copy)]
+enum ScopeSource<'a> {
+    Window,
+    Ref(&'a crate::tree::element::UIAElement),
+}
+
+pub(crate) enum ScopeAuthority {
+    Window {
+        _window: QualifiedWindowProcesses,
+    },
+    Ref {
+        _window: QualifiedWindowProcesses,
+        _element: crate::tree::element::ElementAuthority,
+    },
+}
+
+impl<'a> WindowScope<'a> {
+    pub(crate) fn new(window: &'a WindowInfo, deadline: Deadline) -> Result<Self, AdapterError> {
+        let expected = crate::system::window::window_identity::qualify_window(window, deadline)?;
+        Ok(Self {
+            window,
+            source: ScopeSource::Window,
+            expected,
+            deadline,
+        })
+    }
+
+    pub(crate) fn for_ref(
+        window: &'a WindowInfo,
+        element: &'a crate::tree::element::UIAElement,
+        deadline: Deadline,
+    ) -> Result<Self, AdapterError> {
+        let _authority = crate::tree::element::qualify_verified(element, deadline)?;
+        let expected = crate::system::window::window_identity::qualify_window(window, deadline)?;
+        Ok(Self {
+            window,
+            source: ScopeSource::Ref(element),
+            expected,
+            deadline,
+        })
+    }
+
+    pub(crate) fn qualify(&self) -> Result<ScopeAuthority, AdapterError> {
+        self.deadline.ensure_remaining()?;
+        crate::input::native_owner::ensure_interactive_desktop()?;
+        let current =
+            crate::system::window::window_identity::qualify_window(self.window, self.deadline)?;
+        if current.owner_pid() != self.expected.owner_pid()
+            || current.owner_token() != self.expected.owner_token()
+        {
+            return Err(AdapterError::new(
+                ErrorCode::StaleRef,
+                "Window owner identity changed",
+            ));
+        }
+        let authority = match self.source {
+            ScopeSource::Window => ScopeAuthority::Window { _window: current },
+            ScopeSource::Ref(element) => ScopeAuthority::Ref {
+                _window: current,
+                _element: crate::tree::element::qualify_verified(element, self.deadline)?,
+            },
+        };
+        self.check_foreground()?;
+        Ok(authority)
+    }
+
+    pub(crate) fn check_foreground(&self) -> Result<(), AdapterError> {
+        self.deadline.ensure_remaining()?;
+        agent_desktop_core::commands::clovy_cancel::ensure()?;
+        self.check_foreground_fast()
+    }
+
+    pub(crate) fn check_foreground_fast(&self) -> Result<(), AdapterError> {
+        if !crate::system::window::window_ops::is_foreground_window(
+            crate::system::window::window_ops::parse_handle(&self.window.id),
+        ) {
+            return Err(AdapterError::new(
+                ErrorCode::StaleRef,
+                "Target window is no longer foreground",
+            ));
+        }
+        self.deadline.ensure_remaining()?;
+        Ok(())
+    }
+
+    fn receiver(
+        &self,
+        point: POINT,
+        current_cursor: bool,
+    ) -> Result<
+        (
+            ScopeAuthority,
+            ScopeAuthority,
+            [Option<crate::private_browser_guard::QualifiedProcess>; 3],
+        ),
+        AdapterError,
+    > {
+        let window = self.qualify()?;
+        let target = crate::system::window::window_ops::parse_handle(&self.window.id);
+        let before = native_receivers(point, target)?;
+        let mut qualified: [Option<crate::private_browser_guard::QualifiedProcess>; 3] =
+            [None, None, None];
+        let mut count = 0;
+        for pid in [
+            Some(before.hit_pid),
+            before.foreground_capture_pid,
+            before.hit_capture_pid,
+        ]
+        .into_iter()
+        .flatten()
+        {
+            if qualified
+                .iter()
+                .flatten()
+                .any(|process| process.pid() == pid)
+            {
+                continue;
+            }
+            let token = if pid == self.expected.target_pid() {
+                self.expected.target_token()
+            } else if pid == self.expected.owner_pid() {
+                self.expected.owner_token()
+            } else {
+                return Err(refused());
+            };
+            self.deadline.ensure_remaining()?;
+            qualified[count] = Some(crate::private_browser_guard::qualify_expected(pid, token)?);
+            count += 1;
+        }
+        self.deadline.ensure_remaining()?;
+        let last = self.qualify()?;
+        agent_desktop_core::commands::clovy_cancel::ensure()?;
+        self.deadline.ensure_remaining()?;
+        if current_cursor {
+            let actual = cursor_position()?;
+            if actual.x != point.x || actual.y != point.y {
+                return Err(refused());
+            }
+        }
+        if native_receivers(point, target)? != before {
+            return Err(refused());
+        }
+        self.check_foreground_fast()?;
+        Ok((window, last, qualified))
+    }
+
+    pub(crate) fn post_at(
+        &self,
+        events: &[MouseInputEvent],
+        point: &Point,
+    ) -> Result<(), AdapterError> {
+        point.validate()?;
+        if point.x < f64::from(i32::MIN)
+            || point.x > f64::from(i32::MAX)
+            || point.y < f64::from(i32::MIN)
+            || point.y > f64::from(i32::MAX)
+        {
+            return Err(refused());
+        }
+        let physical = POINT {
+            x: point.x.round() as i32,
+            y: point.y.round() as i32,
+        };
+        let _authority = self.receiver(physical, false)?;
+        post_mouse_inputs(events);
+        Ok(())
+    }
+
+    pub(crate) fn qualify_cursor(
+        &self,
+        expected: &Point,
+    ) -> Result<
+        (
+            ScopeAuthority,
+            ScopeAuthority,
+            [Option<crate::private_browser_guard::QualifiedProcess>; 3],
+        ),
+        AdapterError,
+    > {
+        expected.validate()?;
+        if expected.x < f64::from(i32::MIN)
+            || expected.x > f64::from(i32::MAX)
+            || expected.y < f64::from(i32::MIN)
+            || expected.y > f64::from(i32::MAX)
+        {
+            return Err(refused());
+        }
+        let point = cursor_position()?;
+        let desired_x = expected.x.round() as i32;
+        let desired_y = expected.y.round() as i32;
+        if (i64::from(point.x) - i64::from(desired_x)).abs() > 1
+            || (i64::from(point.y) - i64::from(desired_y)).abs() > 1
+        {
+            return Err(refused());
+        }
+        self.receiver(point, true)
+    }
+
+    pub(crate) fn post_cursor(
+        &self,
+        events: &[MouseInputEvent],
+        expected: &Point,
+    ) -> Result<(), AdapterError> {
+        let _authority = self.qualify_cursor(expected)?;
+        post_mouse_inputs(events);
+        Ok(())
+    }
+
+    pub(crate) fn post_arming_cursor(
+        &self,
+        events: &[MouseInputEvent],
+        expected: &Point,
+        arm: impl FnOnce(),
+    ) -> Result<(), AdapterError> {
+        let _authority = self.qualify_cursor(expected)?;
+        arm();
+        post_mouse_inputs(events);
+        Ok(())
+    }
+}
