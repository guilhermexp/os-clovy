+/// Private embedding bootstrap. The owner supplies a fresh isolated state
+/// root; an ended session is never reopened and this path enables no tracing.
+pub fn ensure_clovy_session(id: &str) -> Result<(), AppError> {
+    validate_session_id(id)?;
+    if let Some(manifest) = read_manifest(id)? {
+        if manifest.ended_at.is_some() {
+            return Err(AppError::invalid_input(
+                "The supervised Computer use session ended",
+            ));
+        }
+        return Ok(());
+    }
+    tree::create(&session_dir(id)?)?;
+    write_manifest(&SessionManifest {
+        id: id.to_owned(),
+        name: Some("Clovy".into()),
+        created_at: now_millis(),
+        ended_at: None,
+        trace: SessionTraceMode::Off,
+        artifacts: ArtifactsMode::Events,
+        cursor_overlay: CursorOverlayConfig::enabled(None, 6)?,
+    })
+}
