@@ -0,0 +1,311 @@
+//! Exact-window guard for Clovy's private physical input argv. Window
+//! identity, geometry, focus and event delivery share one interaction lease.
+use crate::{
+    AdapterError, AppError, Deadline, DeliverySemantics, DragParams, ErrorCode, InteractionLease,
+    MouseEvent, MouseEventKind, PlatformAdapter, Point, WindowInfo, context::CommandContext,
+};
+use serde_json::{Value, json};
+
+fn unsent(message: &str) -> AppError {
+    AdapterError::new(ErrorCode::StaleRef, message)
+        .with_disposition(DeliverySemantics::not_delivered())
+        .into()
+}
+
+fn checked_window(expected: &WindowInfo, live: WindowInfo) -> Result<WindowInfo, AppError> {
+    if expected.id != live.id
+        || expected.pid != live.pid
+        || expected
+            .process_instance
+            .as_deref()
+            .is_none_or(str::is_empty)
+        || expected.process_instance != live.process_instance
+        || expected.title != live.title
+        || expected.bounds.is_none()
+        || expected.bounds != live.bounds
+    {
+        return Err(unsent(
+            "The exact Clovy target identity or geometry changed",
+        ));
+    }
+    Ok(live)
+}
+
+fn prepare(
+    encoded: &str,
+    adapter: &dyn PlatformAdapter,
+    context: &CommandContext,
+) -> Result<(WindowInfo, InteractionLease), AppError> {
+    if !context.is_headed() {
+        return Err(unsent("Private physical input requires visible modality"));
+    }
+    if let Some(error) = adapter.physical_pointer_refusal() {
+        return Err(error.into());
+    }
+    let expected: WindowInfo = serde_json::from_str(encoded)
+        .map_err(|_| unsent("The Clovy target identity is invalid"))?;
+    let lease = adapter.acquire_interaction_lease(Deadline::standard()?)?;
+    let live = checked_window(
+        &expected,
+        adapter.resolve_window_strict(&expected, lease.deadline())?,
+    )?;
+    super::clovy_cancel::ensure()?;
+    adapter.focus_window(&live, &lease)?;
+    let live = checked_window(
+        &expected,
+        adapter.resolve_window_strict(&expected, lease.deadline())?,
+    )?;
+    if !live.state.is_focused
+        || live.state.visible == Some(false)
+        || live.state.minimized == Some(true)
+    {
+        return Err(unsent(
+            "The exact Clovy target did not become visible and focused",
+        ));
+    }
+    Ok((live, lease))
+}
+
+fn checked_point(window: &WindowInfo, point: &Point) -> Result<(), AppError> {
+    point.validate()?;
+    let b = window
+        .bounds
+        .ok_or_else(|| unsent("Missing target geometry"))?
+        .validate()?;
+    if point.x < b.x || point.y < b.y || point.x >= b.x + b.width || point.y >= b.y + b.height {
+        return Err(unsent("The input point is outside the exact Clovy target"));
+    }
+    Ok(())
+}
+
+pub fn mouse(
+    expected: &str,
+    event: MouseEvent,
+    adapter: &dyn PlatformAdapter,
+    context: &CommandContext,
+) -> Result<Value, AppError> {
+    if let MouseEventKind::Click { count } = event.kind {
+        crate::validate_mouse_click_count(count)?;
+    }
+    let (window, lease) = prepare(expected, adapter, context)?;
+    checked_point(&window, &event.point)?;
+    let point = event.point.clone();
+    crate::cursor_overlay::submit_travel(adapter, context, point.clone(), &lease, true);
+    super::clovy_safety::guard_window(adapter, &window, Some(&event.point), lease.deadline())?;
+    let live = checked_window(
+        &window,
+        adapter.resolve_window_strict(&window, lease.deadline())?,
+    )?;
+    if !live.state.is_focused
+        || live.state.visible == Some(false)
+        || live.state.minimized == Some(true)
+    {
+        return Err(unsent("The exact target stopped being visible and focused"));
+    }
+    super::clovy_cancel::ensure()?;
+    let report = adapter.mouse_event(event, &lease);
+    if crate::cursor_overlay::input_was_delivered(&report) {
+        crate::cursor_overlay::submit(
+            adapter,
+            context,
+            point,
+            None,
+            true,
+            crate::CursorPhase::Effect,
+        );
+    }
+    let report = report?;
+    super::operation_response::operation_response(&report, json!({"window_id":window.id}))
+}
+
+pub fn drag(
+    expected: &str,
+    modifiers: Vec<crate::Modifier>,
+    from: (f64, f64),
+    to: (f64, f64),
+    adapter: &dyn PlatformAdapter,
+    context: &CommandContext,
+) -> Result<Value, AppError> {
+    // Mac uses per-event flags; Windows uses one bounded native owner with
+    // preheld-state checks and verified release before cancellation ACK.
+    if !cfg!(any(target_os = "macos", target_os = "windows")) && !modifiers.is_empty() {
+        return Err(AdapterError::new(
+            ErrorCode::ActionNotSupported,
+            "Modifier drag requires per-event modifier flags unavailable on this platform",
+        )
+        .with_disposition(DeliverySemantics::not_delivered())
+        .into());
+    }
+    let (window, lease) = prepare(expected, adapter, context)?;
+    let from = Point {
+        x: from.0,
+        y: from.1,
+    };
+    let to = Point { x: to.0, y: to.1 };
+    checked_point(&window, &from)?;
+    checked_point(&window, &to)?;
+    let params = DragParams {
+        modifiers,
+        from: from.clone(),
+        to: to.clone(),
+        duration_ms: Some(350),
+        drop_delay_ms: Some(150),
+    };
+    params.validate(lease.deadline())?;
+    let cursor = crate::cursor_overlay::hold_cursor(context, lease.deadline());
+    crate::cursor_overlay::submit_travel(adapter, context, from.clone(), &lease, false);
+    crate::cursor_overlay::submit_drag(adapter, context, from.clone(), to.clone(), &lease);
+    super::clovy_safety::guard_drag(adapter, &window, &from, &to, lease.deadline())?;
+    let live = checked_window(
+        &window,
+        adapter.resolve_window_strict(&window, lease.deadline())?,
+    )?;
+    if !live.state.is_focused
+        || live.state.visible == Some(false)
+        || live.state.minimized == Some(true)
+    {
+        return Err(unsent("The exact target stopped being visible and focused"));
+    }
+    super::clovy_cancel::ensure()?;
+    super::clovy_cancel::ensure()?;
+    let report = adapter.drag(params, &lease)?;
+    if crate::cursor_overlay::confirms_delivery(report.disposition()) {
+        crate::cursor_overlay::submit_drag_effect(adapter, context, from, to);
+    }
+    drop(cursor);
+    super::operation_response::operation_response(&report, json!({"window_id":window.id}))
+}
