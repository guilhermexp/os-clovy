+//! Private exact-window input. Expected capture identity is revalidated inside
+//! the interaction lease; preparatory focus is retained as a separate effect.
+use crate::{
+    AdapterError, AppError, Deadline, DeliverySemantics, DragParams, ErrorCode, InteractionLease,
+    MouseEvent, MouseEventKind, PlatformAdapter, Point, WindowInfo, context::CommandContext,
+};
+use serde_json::{Value, json};
+
+fn unsent(message: &str) -> AppError {
+    AdapterError::new(ErrorCode::StaleRef, message)
+        .with_disposition(DeliverySemantics::not_delivered())
+        .into()
+}
+fn checked_window(expected: &WindowInfo, live: WindowInfo) -> Result<WindowInfo, AppError> {
+    if expected.id != live.id
+        || expected.pid != live.pid
+        || expected
+            .process_instance
+            .as_deref()
+            .is_none_or(str::is_empty)
+        || expected.process_instance != live.process_instance
+        || expected.native_owner != live.native_owner
+        || expected.title != live.title
+        || expected.bounds.is_none()
+        || expected.bounds != live.bounds
+    {
+        return Err(unsent(
+            "The exact Clovy target identity or geometry changed",
+        ));
+    }
+    Ok(live)
+}
+fn decode_window(encoded: &str) -> Result<WindowInfo, AppError> {
+    serde_json::from_str(encoded).map_err(|_| unsent("The Clovy target identity is invalid"))
+}
+fn resolve(
+    expected: &WindowInfo,
+    adapter: &dyn PlatformAdapter,
+    lease: &InteractionLease,
+) -> Result<WindowInfo, AppError> {
+    checked_window(
+        expected,
+        adapter.resolve_window_strict(expected, lease.deadline())?,
+    )
+}
+#[derive(Default)]
+struct Effects {
+    focus_attempted: bool,
+    focus_confirmed: bool,
+    window: Option<WindowInfo>,
+    input_attempted: bool,
+    input_receipt: Option<Value>,
+}
+impl Effects {
+    fn focus(
+        &mut self,
+        window: &WindowInfo,
+        adapter: &dyn PlatformAdapter,
+        lease: &InteractionLease,
+    ) -> Result<(), AppError> {
+        self.window = Some(window.clone());
+        self.focus_attempted = true;
+        adapter.focus_window(window, lease)?;
+        // The focus adapter's success is evidence, even if a subsequent guard
+        // or observation fails. Never erase this by labeling all input unsent.
+        self.focus_confirmed = true;
+        Ok(())
+    }
+    fn evidence(&self) -> Value {
+        json!({"focus":{"attempted":self.focus_attempted,"confirmed":self.focus_confirmed,
+            "window_id":self.window.as_ref().map(|w|&w.id),"pid":self.window.as_ref().map(|w|w.pid),
+            "process_instance":self.window.as_ref().and_then(|w|w.process_instance.as_ref())},
+            "target_input":{"attempted":self.input_attempted,"receipt":self.input_receipt}})
+    }
+    fn finish(&self, result: Result<Value, AppError>) -> Result<Value, AppError> {
+        match result {
+            Ok(mut value) => {
+                if let Some(fields) = value.as_object_mut() {
+                    fields.insert("preparatory_effects".into(), self.evidence());
+                }
+                Ok(value)
+            }
+            Err(error) if self.focus_attempted || self.input_receipt.is_some() => {
+                let mut error = match error {
+                    AppError::Adapter(error) => error,
+                    other => AdapterError::internal(other.to_string())
+                        .with_details(json!({"cause_code":other.code()})),
+                };
+                let mut details = error.details.take().unwrap_or_else(|| json!({}));
+                if !details.is_object() {
+                    details = json!({"native_details":details});
+                }
+                let fields = details.as_object_mut().unwrap();
+                // Overall partial delivery must not erase the native target
+                // input/guard refusal that preceded this preparatory merge.
+                fields.insert("native_disposition".into(), json!(error.disposition));
+                fields.insert("preparatory_effects".into(), self.evidence());
+                error = error.with_details(details);
+                if error.disposition.retry() != crate::RetryDisposition::Unsafe {
+                    error = error.with_disposition(
+                        if self.focus_confirmed || self.input_receipt.is_some() {
+                            DeliverySemantics::delivered_unverified()
+                        } else {
+                            DeliverySemantics::uncertain()
+                        },
+                    );
+                }
+                Err(error.into())
+            }
+            Err(error) => Err(error),
+        }
+    }
+}
+fn focused(window: &WindowInfo) -> Result<(), AppError> {
+    if !window.state.is_focused
+        || window.state.visible == Some(false)
+        || window.state.minimized == Some(true)
+    {
+        return Err(unsent(
+            "The exact Clovy target did not remain visible and focused",
+        ));
+    }
+    Ok(())
+}
+fn prepare(
+    expected: &WindowInfo,
+    adapter: &dyn PlatformAdapter,
+    context: &CommandContext,
+    effects: &mut Effects,
+    preflight: impl FnOnce(&WindowInfo, Deadline) -> Result<(), AdapterError>,
+) -> Result<(WindowInfo, InteractionLease), AppError> {
+    if !context.is_headed() {
+        return Err(unsent("Private physical input requires visible modality"));
+    }
+    if let Some(error) = adapter.physical_pointer_refusal() {
+        return Err(error.into());
+    }
+    let lease = adapter.acquire_interaction_lease(Deadline::standard()?)?;
+    let live = resolve(expected, adapter, &lease)?;
+    preflight(&live, lease.deadline())?;
+    // Reads may block or change geometry. Repeat exact validation and Stop
+    // before the first effect, while retaining the final post-focus guard.
+    let live = resolve(expected, adapter, &lease)?;
+    super::clovy_cancel::ensure()?;
+    effects.focus(&live, adapter, &lease)?;
+    super::clovy_cancel::ensure()?;
+    let live = resolve(expected, adapter, &lease)?;
+    focused(&live)?;
+    Ok((live, lease))
+}
+fn checked_point(window: &WindowInfo, point: &Point) -> Result<(), AppError> {
+    point.validate()?;
+    let b = window
+        .bounds
+        .ok_or_else(|| unsent("Missing target geometry"))?
+        .validate()?;
+    if point.x < b.x || point.y < b.y || point.x >= b.x + b.width || point.y >= b.y + b.height {
+        return Err(unsent("The input point is outside the exact Clovy target"));
+    }
+    Ok(())
+}
+pub fn mouse(
+    encoded: &str,
+    event: MouseEvent,
+    adapter: &dyn PlatformAdapter,
+    context: &CommandContext,
+) -> Result<Value, AppError> {
+    if let MouseEventKind::Click { count } = event.kind {
+        crate::validate_mouse_click_count(count)?;
+    }
+    let expected = decode_window(encoded)?;
+    checked_point(&expected, &event.point)?;
+    let mut effects = Effects::default();
+    let result = (|| {
+        let (window, lease) = prepare(
+            &expected,
+            adapter,
+            context,
+            &mut effects,
+            |window, deadline| {
+                super::clovy_safety::guard_window(adapter, window, Some(&event.point), deadline)
+            },
+        )?;
+        let point = event.point.clone();
+        crate::cursor_overlay::submit_travel(adapter, context, point.clone(), &lease, true);
+        super::clovy_safety::guard_window(adapter, &window, Some(&point), lease.deadline())?;
+        let live = resolve(&expected, adapter, &lease)?;
+        focused(&live)?;
+        super::clovy_cancel::ensure()?;
+        effects.input_attempted = true;
+        let report = adapter.mouse_event_for_window(&expected, event, &lease);
+        if crate::cursor_overlay::input_was_delivered(&report) {
+            crate::cursor_overlay::submit(
+                adapter,
+                context,
+                point,
+                None,
+                true,
+                crate::CursorPhase::Effect,
+            );
+        }
+        let report = report?;
+        effects.input_receipt = Some(serde_json::to_value(&report)?);
+        super::operation_response::operation_response(&report, json!({"window_id":window.id}))
+    })();
+    effects.finish(result)
+}
+pub fn drag(
+    encoded: &str,
+    modifiers: Vec<crate::Modifier>,
+    from: (f64, f64),
+    to: (f64, f64),
+    adapter: &dyn PlatformAdapter,
+    context: &CommandContext,
+) -> Result<Value, AppError> {
+    if !cfg!(any(target_os = "macos", target_os = "windows")) && !modifiers.is_empty() {
+        return Err(AdapterError::new(
+            ErrorCode::ActionNotSupported,
+            "Modifier drag requires per-event modifier flags unavailable on this platform",
+        )
+        .with_disposition(DeliverySemantics::not_delivered())
+        .into());
+    }
+    let expected = decode_window(encoded)?;
+    let from = Point {
+        x: from.0,
+        y: from.1,
+    };
+    let to = Point { x: to.0, y: to.1 };
+    checked_point(&expected, &from)?;
+    checked_point(&expected, &to)?;
+    let params = DragParams {
+        modifiers,
+        from: from.clone(),
+        to: to.clone(),
+        duration_ms: Some(350),
+        drop_delay_ms: Some(150),
+    };
+    params.validate(Deadline::standard()?)?;
+    let mut effects = Effects::default();
+    let result = (|| {
+        let (window, lease) = prepare(
+            &expected,
+            adapter,
+            context,
+            &mut effects,
+            |window, deadline| {
+                super::clovy_safety::guard_drag(adapter, window, &from, &to, deadline)
+            },
+        )?;
+        let cursor = crate::cursor_overlay::hold_cursor(context, lease.deadline());
+        crate::cursor_overlay::submit_travel(adapter, context, from.clone(), &lease, false);
+        crate::cursor_overlay::submit_drag(adapter, context, from.clone(), to.clone(), &lease);
+        super::clovy_safety::guard_drag(adapter, &window, &from, &to, lease.deadline())?;
+        let live = resolve(&expected, adapter, &lease)?;
+        focused(&live)?;
+        super::clovy_cancel::ensure()?;
+        effects.input_attempted = true;
+        let report = adapter.drag_for_window(&expected, params, &lease)?;
+        effects.input_receipt = Some(serde_json::to_value(&report)?);
+        if crate::cursor_overlay::confirms_delivery(report.disposition()) {
+            crate::cursor_overlay::submit_drag_effect(adapter, context, from, to);
+        }
+        drop(cursor);
+        super::operation_response::operation_response(&report, json!({"window_id":window.id}))
+    })();
+    effects.finish(result)
+}
+/// Window-key identity is the capture's authority, never a new PID adopted
+/// from a reusable handle. All resolution, focus and input share this lease.
+pub fn press_window(
+    encoded: &str,
+    raw: String,
+    adapter: &dyn PlatformAdapter,
+    context: &CommandContext,
+) -> Result<Value, AppError> {
+    let expected = decode_window(encoded)?;
+    let combo = super::combo::parse_combo_normalized(&raw)?;
+    super::combo::ensure_combo_allowed(&combo, &raw, false, adapter)?;
+    let mut effects = Effects::default();
+    let result = (|| {
+        let lease = adapter.acquire_interaction_lease(Deadline::standard()?)?;
+        let live = resolve(&expected, adapter, &lease)?;
+        super::clovy_safety::guard_window(adapter, &live, None, lease.deadline())?;
+        let mut live = resolve(&expected, adapter, &lease)?;
+        super::clovy_cancel::ensure()?;
+        if context.physical_input_policy().is_headed() {
+            effects.focus(&live, adapter, &lease)?;
+            super::clovy_cancel::ensure()?;
+            live = resolve(&expected, adapter, &lease)?;
+            focused(&live)?;
+        }
+        super::clovy_safety::guard_window(adapter, &live, None, lease.deadline())?;
+        live = resolve(&expected, adapter, &lease)?;
+        super::clovy_cancel::ensure()?;
+        effects.input_attempted = true;
+        let receipt =
+            adapter.press_key_for_window(&live, &combo, context.physical_input_policy(), &lease)?;
+        effects.input_receipt = Some(serde_json::to_value(&receipt)?);
+        crate::cursor_overlay::follow_caret_after_key(adapter, context, Some(live.pid));
+        super::helpers::apply_scoped_post_action_wait(
+            serde_json::to_value(receipt)?,
+            None,
+            Some(expected.id.clone()),
+            adapter,
+            context,
+        )
+    })();
+    effects.finish(result)
+}
+pub fn press(
+    reference: String,
+    raw: String,
+    adapter: &dyn PlatformAdapter,
+    context: &CommandContext,
+) -> Result<Value, AppError> {
+    let combo = super::combo::parse_combo_normalized(&raw)?;
+    super::combo::ensure_combo_allowed(&combo, &raw, false, adapter)?;
+    super::helpers::execute_ref_action_with_context(
+        super::helpers::RefArgs {
+            ref_id: reference,
+            timeout_ms: Some(5000),
+        },
+        adapter,
+        context.request_base(crate::Action::PressKey(combo)),
+        context,
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn changed_process_geometry_or_outside_point_cannot_deliver() {
+        let w:WindowInfo=serde_json::from_value(json!({"id":"w-7","pid":42,"process_instance":"fixture-1","title":"Synthetic","app_name":"Fixture","bounds":{"x":-200.0,"y":10.0,"width":100.0,"height":80.0},"is_focused":true,"visible":true})).unwrap();
+        let mut reused = w.clone();
+        reused.process_instance = Some("fixture-2".into());
+        assert!(checked_window(&w, reused).is_err());
+        let mut moved = w.clone();
+        moved.bounds.as_mut().unwrap().x += 1.0;
+        assert!(checked_window(&w, moved).is_err());
+        assert!(checked_point(&w, &Point { x: -150.0, y: 40.0 }).is_ok());
+        assert!(checked_point(&w, &Point { x: -100.0, y: 40.0 }).is_err());
+    }
+    struct MovesDuringSecurityRead {
+        window: std::sync::Mutex<WindowInfo>,
+        inputs: std::sync::atomic::AtomicUsize,
+    }
+    impl crate::adapter::ActionOps for MovesDuringSecurityRead {}
+    impl crate::adapter::ObservationOps for MovesDuringSecurityRead {
+        fn get_tree(
+            &self,
+            _window: &WindowInfo,
+            _options: &crate::TreeOptions,
+            _deadline: Deadline,
+        ) -> Result<crate::AccessibilityNode, AdapterError> {
+            let mut window = self.window.lock().unwrap();
+            window.bounds.as_mut().unwrap().x += 50.0;
+            Ok(crate::adapter::minimal_accessibility_node(
+                "window",
+                "Synthetic",
+            ))
+        }
+    }
+    impl crate::adapter::SystemOps for MovesDuringSecurityRead {
+        fn acquire_interaction_lease(
+            &self,
+            deadline: Deadline,
+        ) -> Result<InteractionLease, AdapterError> {
+            InteractionLease::guarded(deadline, ())
+        }
+        fn focus_window(
+            &self,
+            _window: &WindowInfo,
+            _lease: &InteractionLease,
+        ) -> Result<(), AdapterError> {
+            Ok(())
+        }
+        fn resolve_window_strict(
+            &self,
+            _window: &WindowInfo,
+            _deadline: Deadline,
+        ) -> Result<WindowInfo, AdapterError> {
+            Ok(self.window.lock().unwrap().clone())
+        }
+    }
+    impl crate::adapter::InputOps for MovesDuringSecurityRead {
+        fn mouse_event_for_window(
+            &self,
+            _window: &WindowInfo,
+            _event: MouseEvent,
+            _lease: &InteractionLease,
+        ) -> Result<crate::OperationReport, AdapterError> {
+            self.inputs
+                .fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            Ok(crate::adapter::test_report())
+        }
+        fn drag_for_window(
+            &self,
+            _window: &WindowInfo,
+            _params: DragParams,
+            _lease: &InteractionLease,
+        ) -> Result<crate::OperationReport, AdapterError> {
+            self.inputs
+                .fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            Ok(crate::adapter::test_report())
+        }
+    }
+    #[test]
+    fn geometry_changed_during_security_inspection_blocks_click_and_drag_before_input() {
+        let window:WindowInfo=serde_json::from_value(json!({"id":"w-7","pid":42,"process_instance":"fixture-1","title":"Synthetic","app_name":"Fixture","bounds":{"x":0.0,"y":0.0,"width":100.0,"height":100.0},"is_focused":true,"visible":true})).unwrap();
+        for gesture in [false, true] {
+            let adapter = MovesDuringSecurityRead {
+                window: std::sync::Mutex::new(window.clone()),
+                inputs: std::sync::atomic::AtomicUsize::new(0),
+            };
+            let context = CommandContext::default().with_headed(true);
+            let encoded = serde_json::to_string(&window).unwrap();
+            let result = if gesture {
+                drag(
+                    &encoded,
+                    vec![],
+                    (10.0, 10.0),
+                    (20.0, 20.0),
+                    &adapter,
+                    &context,
+                )
+            } else {
+                mouse(
+                    &encoded,
+                    MouseEvent {
+                        point: Point { x: 10.0, y: 10.0 },
+                        button: crate::MouseButton::Left,
+                        kind: MouseEventKind::Click { count: 1 },
+                        modifiers: vec![],
+                    },
+                    &adapter,
+                    &context,
+                )
+            };
+            assert_eq!(result.unwrap_err().code(), "STALE_REF");
+            assert_eq!(adapter.inputs.load(std::sync::atomic::Ordering::SeqCst), 0);
+        }
+    }
+}
