@@ -0,0 +1,713 @@
+//! Scoped supervised native-input ownership. All touched keys/buttons must be
+//! initially up, on the active input desktop. Only this owner can acknowledge
+//! after its inner release guards have returned and OS state is observed clear.
+//! This owner only observes. Inner guards release their actually armed keys;
+//! the planned read set never grants permission to release an unposted key.
+//! Concurrent user input can prevent ACK and is left unchanged.
+//!
+//! GetAsyncKeyState zero is meaningful only with an active input desktop,
+//! adequate hook access and compatible foreground integrity:
+//! https://learn.microsoft.com/en-us/windows/win32/api/winuser/nf-winuser-getasynckeystate
+//! SendInput insertion counts are never release/delivery evidence:
+//! https://learn.microsoft.com/en-us/windows/win32/api/winuser/nf-winuser-sendinput
+use agent_desktop_core::{AdapterError, DeliverySemantics, ErrorCode};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::{Duration, Instant};
+// The private Windows host runs one CLI process per tool invocation. These
+// flags span all UIA rungs/threads in that command and never clear mid-command.
+static UIA_ATTEMPTED: AtomicBool = AtomicBool::new(false);
+static DESKTOP_LOST: AtomicBool = AtomicBool::new(false);
+
+fn with_desktop_domain(mut error: AdapterError, attempted: bool) -> AdapterError {
+    let mut details = error
+        .details
+        .take()
+        .unwrap_or_else(|| serde_json::json!({}));
+    if !details.is_object() {
+        details = serde_json::json!({"native_details":details});
+    }
+    if let Some(fields) = details.as_object_mut() {
+        fields.insert(
+            "clovy_code".into(),
+            "computer_use_desktop_unavailable".into(),
+        );
+        fields.insert("uia_effect_attempted".into(), attempted.into());
+    }
+    if attempted
+        && matches!(
+            error.disposition,
+            DeliverySemantics::NotDelivered | DeliverySemantics::Unknown
+        )
+    {
+        error = error.with_disposition(DeliverySemantics::uncertain());
+    }
+    error.with_details(details)
+}
+fn context_unavailable(message: &str) -> AdapterError {
+    if agent_desktop_core::commands::clovy_cancel::supervised() {
+        DESKTOP_LOST.store(true, Ordering::Release);
+    }
+    with_desktop_domain(unsent(message), UIA_ATTEMPTED.load(Ordering::Acquire))
+}
+/// Read-only last-moment gate. Drop native query handles and then recheck Stop
+/// so a blocking readiness query cannot be followed by a late mutation.
+pub(crate) fn ensure_interactive_desktop() -> Result<(), AdapterError> {
+    if !agent_desktop_core::commands::clovy_cancel::supervised() {
+        return Ok(());
+    }
+    let prior = UIA_ATTEMPTED.load(Ordering::Acquire);
+    agent_desktop_core::commands::clovy_cancel::ensure().map_err(|error| {
+        if prior {
+            error.with_disposition(DeliverySemantics::uncertain())
+        } else {
+            error
+        }
+    })?;
+    if DESKTOP_LOST.load(Ordering::Acquire) {
+        return Err(context_unavailable(
+            "The desktop authority was lost; start a new computer-use run",
+        ));
+    }
+    let mut state = NativeState::new();
+    let observation = state.desktop();
+    drop(state);
+    agent_desktop_core::commands::clovy_cancel::ensure().map_err(|error| {
+        if prior {
+            error.with_disposition(DeliverySemantics::uncertain())
+        } else {
+            error
+        }
+    })?;
+    observation.map(|_| ())
+}
+#[cfg(target_os = "windows")]
+pub(crate) fn before_window_effect(
+    window: &agent_desktop_core::WindowInfo,
+    deadline: agent_desktop_core::Deadline,
+    expected: &crate::private_browser_guard::QualifiedWindowProcesses,
+) -> Result<crate::private_browser_guard::QualifiedWindowProcesses, AdapterError> {
+    deadline.ensure_remaining()?;
+    ensure_interactive_desktop()?;
+    let authority = crate::system::window::window_identity::qualify_window(window, deadline)?;
+    if authority.owner_pid() != expected.owner_pid()
+        || authority.owner_token() != expected.owner_token()
+    {
+        return Err(AdapterError::new(
+            ErrorCode::StaleRef,
+            "Window owner identity changed",
+        ));
+    }
+    deadline.ensure_remaining()?;
+    agent_desktop_core::commands::clovy_cancel::ensure()?;
+    let handle = crate::system::window::window_ops::parse_handle(&window.id);
+    let owner = expected.owner_pid();
+    let hosted = crate::system::window::frame_identity::hosted_application_pid(handle);
+    if hosted.unwrap_or(owner) != window.pid
+        || crate::system::window::window_identity::live_window_owner(handle) != Some(owner)
+    {
+        return Err(AdapterError::new(
+            ErrorCode::StaleRef,
+            "Window owner identity changed",
+        ));
+    }
+    deadline.ensure_remaining()?;
+    if agent_desktop_core::commands::clovy_cancel::supervised() {
+        UIA_ATTEMPTED.store(true, Ordering::Release);
+    }
+    Ok(authority)
+}
+
+#[cfg(target_os = "windows")]
+pub(crate) fn before_semantic_effect(
+    element: &crate::tree::element::UIAElement,
+    deadline: agent_desktop_core::Deadline,
+) -> Result<crate::tree::element::ElementAuthority, AdapterError> {
+    let guard_result = (|| {
+        deadline.ensure_remaining()?;
+        ensure_interactive_desktop()?;
+        let authority = crate::tree::element::qualify_verified(element, deadline)?;
+        deadline.ensure_remaining()?;
+        agent_desktop_core::commands::clovy_cancel::ensure()?;
+        deadline.ensure_remaining()?;
+        Ok(authority)
+    })();
+    let authority = guard_result.map_err(|error: AdapterError| {
+        if UIA_ATTEMPTED.load(Ordering::Acquire)
+            && matches!(
+                error.disposition,
+                DeliverySemantics::NotDelivered | DeliverySemantics::Unknown
+            )
+        {
+            error.with_disposition(DeliverySemantics::uncertain())
+        } else {
+            error
+        }
+    })?;
+    UIA_ATTEMPTED.store(true, Ordering::Release);
+    Ok(authority)
+}
+pub(crate) fn finish_action_result(
+    result: Result<agent_desktop_core::ActionResult, AdapterError>,
+) -> Result<agent_desktop_core::ActionResult, AdapterError> {
+    if !agent_desktop_core::commands::clovy_cancel::supervised() {
+        return result;
+    }
+    let _ = ensure_interactive_desktop();
+    settle_action_result(
+        result,
+        DESKTOP_LOST.load(Ordering::Acquire),
+        UIA_ATTEMPTED.load(Ordering::Acquire),
+    )
+}
+fn settle_action_result(
+    result: Result<agent_desktop_core::ActionResult, AdapterError>,
+    lost: bool,
+    attempted: bool,
+) -> Result<agent_desktop_core::ActionResult, AdapterError> {
+    if !lost {
+        return result;
+    }
+    match result {
+        Err(error) => Err(with_desktop_domain(error, attempted)),
+        Ok(prior) => {
+            let disposition = prior.disposition();
+            let mut error = with_desktop_domain(
+                unsent("Desktop authority was lost after the action"),
+                attempted,
+            );
+            if disposition.retry() == agent_desktop_core::RetryDisposition::Unsafe {
+                error = error.with_disposition(disposition);
+            }
+            if let Some(fields) = error
+                .details
+                .as_mut()
+                .and_then(serde_json::Value::as_object_mut)
+            {
+                fields.insert(
+                    "prior_action_result".into(),
+                    serde_json::to_value(prior).unwrap_or(serde_json::Value::Null),
+                );
+            }
+            Err(error)
+        }
+    }
+}
+pub(crate) fn finish_unit_result(result: Result<(), AdapterError>) -> Result<(), AdapterError> {
+    if !agent_desktop_core::commands::clovy_cancel::supervised() {
+        return result;
+    }
+    let _ = ensure_interactive_desktop();
+    if !DESKTOP_LOST.load(Ordering::Acquire) {
+        return result;
+    }
+    Err(with_desktop_domain(
+        result
+            .err()
+            .unwrap_or_else(|| unsent("Desktop authority was lost after the action")),
+        UIA_ATTEMPTED.load(Ordering::Acquire),
+    ))
+}
+
+pub(crate) trait Observations {
+    type Desktop: Clone + PartialEq;
+    fn desktop(&mut self) -> Result<Self::Desktop, AdapterError>;
+    fn down(&mut self, key: u16) -> Result<bool, AdapterError>;
+}
+struct Owner<S: Observations> {
+    state: S,
+    desktop: S::Desktop,
+    keys: Vec<u16>,
+}
+fn unsent(message: &str) -> AdapterError {
+    AdapterError::new(ErrorCode::ActionFailed, message)
+        .with_disposition(DeliverySemantics::not_delivered())
+}
+impl<S: Observations> Owner<S> {
+    fn begin(mut state: S, keys: Vec<u16>) -> Result<Self, AdapterError> {
+        let desktop = state.desktop()?;
+        let mut unique = Vec::new();
+        for key in keys {
+            if unique.contains(&key) {
+                continue;
+            }
+            if state.down(key)? {
+                return Err(unsent(
+                    "An input key or button is already held; take over before this action",
+                ));
+            }
+            unique.push(key);
+        }
+        if state.desktop()? != desktop {
+            return Err(unsent("The active input desktop changed before input"));
+        }
+        Ok(Self {
+            state,
+            desktop,
+            keys: unique,
+        })
+    }
+    fn released(&mut self) -> Result<bool, AdapterError> {
+        if self.state.desktop()? != self.desktop {
+            return Err(unsent(
+                "The input desktop changed during release observation",
+            ));
+        }
+        let mut held = Vec::new();
+        for key in &self.keys {
+            if self.state.down(*key)? {
+                held.push(*key);
+            }
+        }
+        if self.state.desktop()? != self.desktop {
+            return Err(unsent(
+                "The input desktop changed during release observation",
+            ));
+        }
+        Ok(held.is_empty())
+    }
+    fn finish(
+        mut self,
+        result: Result<(), AdapterError>,
+        acknowledge: impl FnOnce(bool),
+    ) -> Result<(), AdapterError> {
+        let limit = Instant::now() + Duration::from_millis(40);
+        let mut previous_clear = false;
+        let released = loop {
+            if Instant::now() >= limit {
+                break Err(unsent("The owned input release observation expired"));
+            }
+            let observation = self.released();
+            if Instant::now() >= limit {
+                break Err(unsent("The owned input release observation expired"));
+            }
+            match observation {
+                Ok(true) if previous_clear => break Ok(()),
+                Ok(clear) => previous_clear = clear,
+                Err(error) => break Err(error),
+            }
+            if Instant::now() >= limit {
+                break Err(unsent("Owned input was not observed released"));
+            }
+            std::thread::sleep(Duration::from_millis(2));
+        };
+        acknowledge(released.is_ok());
+        match released {
+            Ok(()) => result,
+            Err(observation) => {
+                let mut error = result.err().unwrap_or_else(|| {
+                    AdapterError::new(
+                        ErrorCode::ActionFailed,
+                        "Native input release could not be verified",
+                    )
+                });
+                let mut details = error
+                    .details
+                    .take()
+                    .unwrap_or_else(|| serde_json::json!({}));
+                if let Some(map) = details.as_object_mut() {
+                    if let Some(domain) = observation
+                        .details
+                        .as_ref()
+                        .and_then(|details| details.get("clovy_code"))
+                    {
+                        map.insert("clovy_code".into(), domain.clone());
+                    }
+                    map.insert("release_verified".into(), false.into());
+                    map.insert(
+                        "release_observation_error".into(),
+                        observation.message.into(),
+                    );
+                }
+                Err(error
+                    .with_details(details)
+                    .with_disposition(DeliverySemantics::uncertain()))
+            }
+        }
+    }
+}
