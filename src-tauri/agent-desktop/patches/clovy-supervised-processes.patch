+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        cell::{Cell, RefCell},
+        rc::Rc,
+    };
+    struct Read {
+        held: Rc<RefCell<Vec<u16>>>,
+        fail: Rc<Cell<bool>>,
+        desktop: Rc<Cell<u8>>,
+        delay_ms: Rc<Cell<u64>>,
+    }
+    impl Observations for Read {
+        type Desktop = u8;
+        fn desktop(&mut self) -> Result<u8, AdapterError> {
+            std::thread::sleep(Duration::from_millis(self.delay_ms.get()));
+            if self.fail.get() {
+                Err(unsent("query failed"))
+            } else {
+                Ok(self.desktop.get())
+            }
+        }
+        fn down(&mut self, key: u16) -> Result<bool, AdapterError> {
+            Ok(self.held.borrow().contains(&key))
+        }
+    }
+    fn state() -> (Read, Rc<RefCell<Vec<u16>>>, Rc<Cell<bool>>, Rc<Cell<u8>>) {
+        let held = Rc::new(RefCell::new(vec![]));
+        let fail = Rc::new(Cell::new(false));
+        let desktop = Rc::new(Cell::new(1));
+        (
+            Read {
+                held: held.clone(),
+                fail: fail.clone(),
+                desktop: desktop.clone(),
+                delay_ms: Rc::new(Cell::new(0)),
+            },
+            held,
+            fail,
+            desktop,
+        )
+    }
+    #[test]
+    fn preheld_user_key_is_never_borrowed_or_released() {
+        let (read, held, _, _) = state();
+        held.borrow_mut().push(0x10);
+        assert!(Owner::begin(read, vec![0x10, 1]).is_err());
+        assert_eq!(*held.borrow(), [0x10]);
+    }
+    #[test]
+    fn only_released_owned_keys_can_acknowledge_and_unknown_keeps_unsafe_receipt() {
+        for failed_query in [false, true] {
+            let (read, held, fail, _) = state();
+            let owner = Owner::begin(read, vec![0x10, 0x11, 1]).unwrap();
+            held.borrow_mut().extend([0x10, 0x11, 1]);
+            // The inner guards, not this observing owner, release only keys
+            // they actually armed before returning to finish.
+            held.borrow_mut().clear();
+            fail.set(failed_query);
+            let ack = Cell::new(false);
+            let result = owner.finish(Ok(()), |released| ack.set(released));
+            assert_eq!(ack.get(), !failed_query);
+            if failed_query {
+                assert_eq!(
+                    result.unwrap_err().disposition,
+                    DeliverySemantics::uncertain()
+                );
+            } else {
+                result.unwrap();
+            }
+        }
+    }
+    #[test]
+    fn changed_desktop_or_held_key_never_acknowledges() {
+        for change_desktop in [false, true] {
+            let (read, held, _, desktop) = state();
+            let owner = Owner::begin(read, vec![0x12]).unwrap();
+            if change_desktop {
+                desktop.set(2);
+            } else {
+                held.borrow_mut().push(0x12);
+            }
+            let ack = Cell::new(false);
+            let result = owner.finish(Ok(()), |released| ack.set(released));
+            assert!(!ack.get());
+            assert_eq!(
+                result.unwrap_err().disposition,
+                DeliverySemantics::uncertain()
+            );
+        }
+    }
+    #[test]
+    fn an_unposted_planned_key_pressed_by_the_user_is_never_released() {
+        let (read, held, _, _) = state();
+        let owner = Owner::begin(read, vec![0x11, 0x41]).unwrap();
+        // Ctrl was posted and its actual inner guard released it. Stop
+        // prevented A from being posted; a concurrent human then pressed A.
+        held.borrow_mut().push(0x41);
+        let ack = Cell::new(false);
+        let outcome = owner.finish(Err(unsent("Stopped before A")), |released| {
+            ack.set(released)
+        });
+        assert!(!ack.get());
+        assert_eq!(*held.borrow(), [0x41]);
+        assert_eq!(
+            outcome.unwrap_err().disposition,
+            DeliverySemantics::uncertain()
+        );
+    }
+    #[test]
+    fn an_expired_native_observation_never_acknowledges_even_if_it_returns_clear() {
+        struct SlowSecond(u8);
+        impl Observations for SlowSecond {
+            type Desktop = u8;
+            fn desktop(&mut self) -> Result<u8, AdapterError> {
+                self.0 += 1;
+                // Begin uses reads1-2; first clear observation uses3-4.
+                // Only the second clear observation blocks past the budget.
+                if self.0 >= 5 {
+                    std::thread::sleep(Duration::from_millis(25));
+                }
+                Ok(1)
+            }
+            fn down(&mut self, _key: u16) -> Result<bool, AdapterError> {
+                Ok(false)
+            }
+        }
+        let owner = Owner::begin(SlowSecond(0), vec![0x11]).unwrap();
+        let ack = Cell::new(false);
+        let result = owner.finish(Ok(()), |released| ack.set(released));
+        assert!(!ack.get());
+        assert_eq!(
+            result.unwrap_err().disposition,
+            DeliverySemantics::uncertain()
+        );
+    }
+    #[test]
+    fn desktop_loss_preserves_domain_and_prior_delivery_at_the_outer_error() {
+        let before = with_desktop_domain(unsent("Locked"), false);
+        assert_eq!(before.disposition, DeliverySemantics::not_delivered());
+        assert_eq!(
+            before.details.as_ref().unwrap()["clovy_code"],
+            "computer_use_desktop_unavailable"
+        );
+        let scalar = with_desktop_domain(
+            unsent("Locked").with_details(serde_json::json!("native cause")),
+            false,
+        );
+        assert_eq!(
+            scalar.details.as_ref().unwrap()["clovy_code"],
+            "computer_use_desktop_unavailable"
+        );
+        assert_eq!(
+            scalar.details.as_ref().unwrap()["native_details"],
+            "native cause"
+        );
+        let after = with_desktop_domain(unsent("Locked"), true);
+        assert_eq!(after.disposition, DeliverySemantics::uncertain());
+        let unknown = with_desktop_domain(
+            unsent("Locked").with_disposition(DeliverySemantics::unknown()),
+            true,
+        );
+        assert_eq!(unknown.disposition, DeliverySemantics::uncertain());
+        let prior = agent_desktop_core::ActionResult::delivered_unverified("click");
+        let error = settle_action_result(Ok(prior), true, true).unwrap_err();
+        assert_eq!(error.disposition, DeliverySemantics::delivered_unverified());
+        assert_eq!(
+            error.details.as_ref().unwrap()["clovy_code"],
+            "computer_use_desktop_unavailable"
+        );
+        assert!(
+            error
+                .details
+                .as_ref()
+                .unwrap()
+                .get("prior_action_result")
+                .is_some()
+        );
+    }
+}
