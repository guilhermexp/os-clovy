+        __attribute__((objc_precise_lifetime)) NSRunningApplication *app =
+            [NSRunningApplication runningApplicationWithProcessIdentifier:pid];
+        if (app == nil) { return 0; }
+        __attribute__((objc_precise_lifetime)) NSString *path = app.executableURL.path;
+        __attribute__((objc_precise_lifetime)) NSString *bundle = app.bundleIdentifier;
+        const char *pathBytes = path.UTF8String;
+        const char *bundleBytes = bundle.UTF8String;
+        NSDate *launchDate = app.launchDate;
+        AgentDesktopLaunchResult result = {
+            .application = (__bridge void *)app,
+            .pid = app.processIdentifier,
+            .launchTime = launchDate == nil ? 0.0 : launchDate.timeIntervalSince1970,
+            .terminated = app.isTerminated,
+            .deliveryStarted = 0,
+            .errorKind = 0,
+            .error = NULL,
+            .errorLength = 0,
+            .executablePath = pathBytes,
+            .executablePathLength = pathBytes == NULL ? 0 : strlen(pathBytes),
+            .bundleIdentifier = bundleBytes,
+            .bundleIdentifierLength = bundleBytes == NULL ? 0 : strlen(bundleBytes),
+        };
+        completion(context, &result);
+        return 1;
+    } @catch (NSException *exception) {
+        (void)exception;
+        return 0;
+    }
+}
