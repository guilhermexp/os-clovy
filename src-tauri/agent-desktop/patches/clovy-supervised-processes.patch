+#[test]
+fn clovy_sticky_cancel_releases_before_ack_and_never_sends_after_ack() {
+    for fail in [false, true] {
+        let root = std::env::temp_dir().join(format!(
+            "clovy-cancel-proof-{}-{}",
+            std::process::id(),
+            fail
+        ));
+        std::fs::create_dir_all(&root).unwrap();
+        let result = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "clovy_cancel_native_owner_subprocess",
+                "--ignored",
+                "--test-threads=1",
+            ])
+            .env("CLOVY_AGENT_DESKTOP_SUPERVISED", "1")
+            .env("CLOVY_AGENT_DESKTOP_CANCEL_FILE", root.join("cancel"))
+            .env(
+                "CLOVY_AGENT_DESKTOP_CANCEL_ACK_FILE",
+                root.join("cancel-ack"),
+            )
+            .env(
+                "CLOVY_TEST_RELEASE_QUERY_FAIL",
+                if fail { "1" } else { "0" },
+            )
+            .output()
+            .unwrap();
+        assert!(
+            result.status.success(),
+            "{}\n{}",
+            String::from_utf8_lossy(&result.stdout),
+            String::from_utf8_lossy(&result.stderr)
+        );
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
+
+#[test]
+#[ignore = "isolated child of clovy sticky cancellation regression"]
+fn clovy_cancel_native_owner_subprocess() {
+    use crate::input::x11::fake_sink::Recorded;
+    let cancel =
+        std::path::PathBuf::from(std::env::var_os("CLOVY_AGENT_DESKTOP_CANCEL_FILE").unwrap());
+    let ack = cancel.with_file_name("cancel-ack");
+    let mut fake = FakeSink::new();
+    let fail = std::env::var("CLOVY_TEST_RELEASE_QUERY_FAIL").unwrap() == "1";
+    let progress = Progress::default();
+    let limit = deadline(30_000);
+    fake.world().fail_verification = fail;
+    let observer = fake.clone();
+    let mut guard = ReleaseGuard::new(&mut fake);
+    run_step(
+        &mut guard,
+        &Step::Button {
+            code: 1,
+            down: true,
+        },
+        limit,
+        &progress,
+    )
+    .unwrap();
+    std::fs::write(&cancel, b"stop").unwrap();
+    let error = check_alive(limit, &progress, guard.delivered()).unwrap_err();
+    super::abort_cancelled(&mut guard, error, super::ABORT_SUGGESTION);
+    assert_eq!(ack.is_file(), !fail);
+    let count = guard.delivered();
+    let events_at_ack = events(&observer).len();
+    for _ in 0..3 {
+        assert!(
+            run_step(
+                &mut guard,
+                &Step::MoveTo { x: 120, y: 120 },
+                limit,
+                &progress
+            )
+            .is_err()
+        );
+        assert_eq!(guard.delivered(), count);
+    }
+    drop(guard);
+    let final_events = events(&fake);
+    assert_eq!(
+        final_events.len(),
+        events_at_ack,
+        "native sends after release acknowledgement"
+    );
+    assert_eq!(
+        final_events
+            .iter()
+            .filter(|e| matches!(e, Recorded::Button(1, false)))
+            .count(),
+        1
+    );
+    assert!(
+        !final_events
+            .iter()
+            .any(|e| matches!(e, Recorded::Move(120, 120)))
+    );
+}
