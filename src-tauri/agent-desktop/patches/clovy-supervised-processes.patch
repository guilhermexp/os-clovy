+fn hold_keys_checked<G>(
+    keys: impl Iterator<Item = u16>,
+    mut before_down: impl FnMut() -> Result<G, AdapterError>,
+) -> Result<ModifierGuard, AdapterError> {
+    let mut guard = ModifierGuard {
+        held: vec![],
+        released: false,
+        delivered: false,
+    };
+    for vk in keys {
+        if guard.held.contains(&vk) {
+            continue;
+        }
+        post_keyboard_inputs(&[key_input(vk, false)], || {
+            let authority = before_down().map_err(|error| guard.enrich_error(error))?;
+            guard.held.push(vk);
+            guard.delivered = true;
+            Ok(authority)
+        })?;
+    }
+    Ok(guard)
+}
