+        assert_eq!(world.focuses.load(Ordering::SeqCst), 0);
+        assert_eq!(world.inputs.load(Ordering::SeqCst), 0);
+        match error {
+            AppError::Adapter(error) => {
+                assert_eq!(error.disposition, DeliverySemantics::not_delivered())
+            }
+            other => panic!("{other}"),
+        }
+    }
+}
+#[test]
+fn cancellation_after_focus_preserves_partial_delivery_in_isolated_consumer_process() {
+    for dragging in [false, true] {
+        let root = std::env::var_os("CLOVY_A2_PROOF_ROOT")
+            .map(std::path::PathBuf::from)
+            .unwrap_or_else(std::env::temp_dir)
+            .join(format!(
+                "clovy-a2-{}-{}",
+                std::process::id(),
+                std::time::SystemTime::now()
+                    .duration_since(std::time::UNIX_EPOCH)
+                    .unwrap()
+                    .as_nanos()
+            ));
+        std::fs::create_dir_all(&root).unwrap();
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--ignored",
+                "--exact",
+                "commands::clovy_targeted::review_tests::cancellation_after_focus_child",
+                "--nocapture",
+            ])
+            .env("CLOVY_AGENT_DESKTOP_SUPERVISED", "1")
+            .env("CLOVY_AGENT_DESKTOP_CANCEL_FILE", root.join("cancel"))
+            .env(
+                "CLOVY_AGENT_DESKTOP_CANCEL_ACK_FILE",
+                root.join("cancel-ack"),
+            )
+            .env("CLOVY_A2_DRAG", if dragging { "1" } else { "0" })
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{}\n{}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+    }
+}
+#[test]
+#[ignore = "only the isolated consumer parent sets the private cancellation namespace"]
+fn cancellation_after_focus_child() {
+    assert_eq!(
+        std::env::var("CLOVY_AGENT_DESKTOP_SUPERVISED").unwrap(),
+        "1"
+    );
+    assert_after_focus(
+        Change::CancelAfterFocus,
+        std::env::var("CLOVY_A2_DRAG").unwrap() == "1",
+    );
+}
+
+#[test]
+fn native_input_refusal_after_focus_retains_original_disposition_without_replay() {
+    for dragging in [false, true] {
+        let world = World::new(Change::InputRefused);
+        let error = gesture(&world, dragging).unwrap_err();
+        assert_eq!(world.focuses.load(Ordering::SeqCst), 1);
+        assert_eq!(world.native_input_calls.load(Ordering::SeqCst), 1);
+        assert_eq!(world.inputs.load(Ordering::SeqCst), 0);
+        match error {
+            AppError::Adapter(error) => {
+                assert_eq!(error.code, ErrorCode::ActionNotSupported);
+                assert_eq!(error.disposition, DeliverySemantics::delivered_unverified());
+                let details = error.details.unwrap();
+                assert_eq!(
+                    details["native_disposition"],
+                    json!(DeliverySemantics::not_delivered())
+                );
+                assert_eq!(details["native_reason"], "preflight_not_attempted");
+                assert_eq!(details["preparatory_effects"]["focus"]["confirmed"], true);
+                assert_eq!(
+                    details["preparatory_effects"]["target_input"]["attempted"],
+                    true
+                );
+            }
+            other => panic!("{other}"),
+        }
+    }
+}
