+pub(crate) fn sleep_bounded(deadline: Deadline, duration: Duration) -> Result<(), AdapterError> {
+    let mut left = duration;
+    while !left.is_zero() {
+        agent_desktop_core::commands::clovy_cancel::ensure()?;
+        let pause = deadline.remaining_slice(left.min(Duration::from_millis(10)))?;
+        std::thread::sleep(pause);
+        left = left.saturating_sub(pause);
+    }
