diff --git a/crates/core/src/commands/clovy_cancel.rs b/crates/core/src/commands/clovy_cancel.rs
new file mode 100644
index 0000000..c1f81d3
--- /dev/null
+++ b/crates/core/src/commands/clovy_cancel.rs
@@ -0,0 +1,88 @@
+//! Private supervised run cancellation. Only the active native input owner may
+//! acknowledge after its release guard has completed and OS state is clear.
+use crate::{AdapterError, DeliverySemantics, ErrorCode};
+use std::{
+    fs::{self, OpenOptions},
+    path::PathBuf,
+    sync::atomic::{AtomicBool, Ordering},
+};
+static STOPPED: AtomicBool = AtomicBool::new(false);
+fn paths() -> Option<(PathBuf, PathBuf)> {
+    let cancel = PathBuf::from(std::env::var_os("CLOVY_AGENT_DESKTOP_CANCEL_FILE")?);
+    let ack = PathBuf::from(std::env::var_os("CLOVY_AGENT_DESKTOP_CANCEL_ACK_FILE")?);
+    valid_paths(cancel, ack)
+}
+fn valid_paths(cancel: PathBuf, ack: PathBuf) -> Option<(PathBuf, PathBuf)> {
+    let parent = cancel.parent()?;
+    if !cancel.is_absolute()
+        || !ack.is_absolute()
+        || ack.parent() != Some(parent)
+        || cancel.file_name()? != "cancel"
+        || ack.file_name()? != "cancel-ack"
+        || !fs::symlink_metadata(parent).is_ok_and(|m| m.is_dir() && !m.file_type().is_symlink())
+    {
+        return None;
+    }
+    Some((cancel, ack))
+}
+pub fn supervised() -> bool {
+    std::env::var_os("CLOVY_AGENT_DESKTOP_SUPERVISED").as_deref() == Some(std::ffi::OsStr::new("1"))
+}
+pub fn cancelled() -> bool {
+    if !supervised() {
+        return false;
+    }
+    if STOPPED.load(Ordering::Acquire) {
+        return true;
+    }
+    let stopped = paths().is_none_or(|(cancel, _)| match fs::symlink_metadata(cancel) {
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => false,
+        _ => true,
+    });
+    if stopped {
+        STOPPED.store(true, Ordering::Release);
+    }
+    stopped
+}
+pub fn ensure() -> Result<(), AdapterError> {
+    if !cancelled() {
+        return Ok(());
+    }
+    Err(AdapterError::new(ErrorCode::ActionFailed,"The computer-use run was stopped")
+        .with_details(serde_json::json!({"clovy_code":"computer_use_stopped","physical_delivery_started":false}))
+        .with_disposition(DeliverySemantics::not_delivered()))
+}
+/// Called exclusively by the current native input owner after verified release.
+/// This never emits input, and the sticky marker rejects all later dispatch.
+pub fn acknowledge_release(released: bool) {
+    if !released || !cancelled() {
+        return;
+    }
+    let Some((cancel, ack)) = paths() else {
+        return;
+    };
+    if !fs::symlink_metadata(cancel).is_ok_and(|m| m.is_file() && !m.file_type().is_symlink()) {
+        return;
+    }
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let _ = options.open(ack);
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn clovy_cancel_contract_rejects_cross_namespace_and_symlink_parent() {
+        let root = std::env::temp_dir().join(format!("clovy-cancel-{}", std::process::id()));
+        fs::create_dir_all(&root).unwrap();
+        assert!(valid_paths(root.join("cancel"), root.join("cancel-ack")).is_some());
+        assert!(valid_paths(root.join("cancel"), root.join("foreign/cancel-ack")).is_none());
+        assert!(valid_paths(root.join("other"), root.join("cancel-ack")).is_none());
+        fs::remove_dir(root).unwrap();
+    }
+}
