+#[test]
+fn unicode_character_limit_reaches_the_action_without_byte_truncation() {
+    let _guard = HomeGuard::new();
+    let adapter = StaleThenOkAdapter::new(0);
+    let text = "🦀".repeat(10_000);
+    execute(
+        TypeArgs {
+            ref_id: format!("@{}:e1", snapshot_id()),
+            text: text.clone(),
+            timeout_ms: Some(0),
+            interval_ms: None,
+        },
+        &adapter,
+        &CommandContext::default(),
+    )
+    .unwrap();
+    assert_eq!(*adapter.value.lock().unwrap(), text);
+    let error = execute(
+        TypeArgs {
+            ref_id: format!("@{}:e1", snapshot_id()),
+            text: "🦀".repeat(10_001),
+            timeout_ms: Some(0),
+            interval_ms: None,
+        },
+        &adapter,
+        &CommandContext::default(),
+    )
+    .unwrap_err();
+    assert_eq!(error.code(), "INVALID_ARGS");
+    assert_eq!(*adapter.value.lock().unwrap(), text);
+}
