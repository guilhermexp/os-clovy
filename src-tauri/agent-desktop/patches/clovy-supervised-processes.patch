+#[cfg(target_os = "windows")]
+struct DesktopHandle(*mut std::ffi::c_void);
+#[cfg(target_os = "windows")]
+impl DesktopHandle {
+    fn open() -> Result<Self, AdapterError> {
+        #[link(name = "user32")]
+        unsafe extern "system" {
+            fn OpenInputDesktop(flags: u32, inherit: i32, access: u32) -> *mut std::ffi::c_void;
+        }
+        const DESKTOP_READOBJECTS: u32 = 0x0001;
+        const DESKTOP_HOOKCONTROL: u32 = 0x0008;
+        let handle = unsafe { OpenInputDesktop(0, 0, DESKTOP_READOBJECTS | DESKTOP_HOOKCONTROL) };
+        if handle.is_null() {
+            Err(context_unavailable(
+                "The active input desktop cannot be inspected with hook access",
+            ))
+        } else {
+            Ok(Self(handle))
+        }
+    }
+}
+#[cfg(target_os = "windows")]
+impl Drop for DesktopHandle {
+    fn drop(&mut self) {
+        #[link(name = "user32")]
+        unsafe extern "system" {
+            fn CloseDesktop(desktop: *mut std::ffi::c_void) -> i32;
+        }
+        unsafe {
+            CloseDesktop(self.0);
+        }
+    }
+}
+#[cfg(target_os = "windows")]
+impl Observations for NativeState {
+    type Desktop = (String, String);
+    fn desktop(&mut self) -> Result<Self::Desktop, AdapterError> {
+        use std::ffi::c_void;
+        #[link(name = "user32")]
+        unsafe extern "system" {
+            fn GetThreadDesktop(thread: u32) -> *mut c_void;
+            fn GetProcessWindowStation() -> *mut c_void;
+            fn GetUserObjectInformationW(
+                object: *mut c_void,
+                index: i32,
+                data: *mut c_void,
+                length: u32,
+                needed: *mut u32,
+            ) -> i32;
+        }
+        #[link(name = "kernel32")]
+        unsafe extern "system" {
+            fn GetCurrentThreadId() -> u32;
+        }
+        fn name(object: *mut c_void) -> Result<String, AdapterError> {
+            if object.is_null() {
+                return Err(context_unavailable("The input desktop is unavailable"));
+            }
+            let mut needed = 0u32;
+            unsafe {
+                GetUserObjectInformationW(object, 2, std::ptr::null_mut(), 0, &mut needed);
+            }
+            if !(2..=8192).contains(&needed) || needed % 2 != 0 {
+                return Err(context_unavailable(
+                    "The input desktop identity is unavailable",
+                ));
+            }
+            let mut data = vec![0u16; needed as usize / 2];
+            if unsafe {
+                GetUserObjectInformationW(object, 2, data.as_mut_ptr().cast(), needed, &mut needed)
+            } == 0
+            {
+                return Err(context_unavailable(
+                    "The input desktop identity is unavailable",
+                ));
+            }
+            let end = data.iter().position(|c| *c == 0).unwrap_or(data.len());
+            String::from_utf16(&data[..end])
+                .map_err(|_| context_unavailable("The input desktop identity is invalid"))
+        }
+        if self.input.is_none() {
+            self.input = Some(DesktopHandle::open()?);
+        }
+        let active = DesktopHandle::open()?;
+        let input_name = name(active.0)?;
+        let retained = self
+            .input
+            .as_ref()
+            .ok_or_else(|| context_unavailable("The owned input desktop is unavailable"))?;
+        if name(retained.0)? != input_name {
+            return Err(context_unavailable("The active input desktop changed"));
+        }
+        let thread_name = name(unsafe { GetThreadDesktop(GetCurrentThreadId()) })?;
+        let station = name(unsafe { GetProcessWindowStation() })?;
+        if !station.eq_ignore_ascii_case("WinSta0")
+            || !input_name.eq_ignore_ascii_case("Default")
+            || thread_name != input_name
+        {
+            return Err(context_unavailable(
+                "Native input requires this process's active interactive desktop",
+            ));
+        }
+        foreground_observation()?;
+        Ok((station, input_name))
+    }
+    fn down(&mut self, key: u16) -> Result<bool, AdapterError> {
+        #[link(name = "user32")]
+        unsafe extern "system" {
+            fn GetAsyncKeyState(key: i32) -> i16;
+        }
+        let before = foreground_observation()?;
+        let down = (unsafe { GetAsyncKeyState(i32::from(key)) }) & i16::MIN != 0;
+        if foreground_observation()? != before {
+            return Err(context_unavailable(
+                "The foreground changed during key-state observation",
+            ));
+        }
+        Ok(down)
+    }
+}
+#[cfg(target_os = "windows")]
+fn foreground_observation() -> Result<(usize, u32, String), AdapterError> {
+    use std::ffi::c_void;
+    #[link(name = "user32")]
+    unsafe extern "system" {
+        fn GetForegroundWindow() -> *mut c_void;
+        fn GetWindowThreadProcessId(window: *mut c_void, pid: *mut u32) -> u32;
+    }
+    let foreground = unsafe { GetForegroundWindow() };
+    let mut pid = 0u32;
+    if foreground.is_null()
+        || unsafe { GetWindowThreadProcessId(foreground, &mut pid) } == 0
+        || pid == 0
+    {
+        return Err(context_unavailable(
+            "The foreground process identity is unavailable",
+        ));
+    }
+    let process = agent_desktop_core::ProcessId::new(pid);
+    let caller = super::elevation::current_process_integrity_rid()
+        .ok_or_else(|| context_unavailable("The native input caller integrity is unknown"))?;
+    let target = super::elevation::process_integrity_rid(process)
+        .ok_or_else(|| context_unavailable("The foreground integrity is unknown"))?;
+    if target > caller {
+        return Err(context_unavailable(
+            "The foreground integrity prevents reliable key-state observation",
+        ));
+    }
+    let token = crate::system::process_identity::token_for_pid(process)
+        .map_err(|_| context_unavailable("The foreground process generation cannot be inspected"))?
+        .ok_or_else(|| context_unavailable("The foreground process generation is unknown"))?;
+    let mut after = 0u32;
+    if unsafe { GetForegroundWindow() } != foreground
+        || unsafe { GetWindowThreadProcessId(foreground, &mut after) } == 0
+        || after != pid
+    {
+        return Err(context_unavailable(
+            "The foreground process changed during input observation",
+        ));
+    }
+    Ok((foreground as usize, pid, token))
+}
