+use super::*;
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicBool, AtomicUsize, Ordering},
+};
+#[derive(Clone, Copy)]
+enum Change {
+    Stable,
+    ReusedAtLease,
+    ReusedBeforeResolve,
+    SecureBeforeFocus,
+    SecureAfterFocus,
+    ResolveAfterFocus,
+    CancelAfterFocus,
+    InputRefused,
+}
+struct World {
+    window: Mutex<WindowInfo>,
+    change: Change,
+    leased: Arc<AtomicBool>,
+    focuses: AtomicUsize,
+    inputs: AtomicUsize,
+    native_input_calls: AtomicUsize,
+}
+impl World {
+    fn new(change: Change) -> Self {
+        let mut initial = window();
+        if matches!(change, Change::ReusedBeforeResolve) {
+            initial.pid = crate::ProcessId::new(99);
+            initial.process_instance = Some("B:2".into());
+        }
+        Self {
+            window: Mutex::new(initial),
+            change,
+            leased: Arc::new(AtomicBool::new(false)),
+            focuses: AtomicUsize::new(0),
+            inputs: AtomicUsize::new(0),
+            native_input_calls: AtomicUsize::new(0),
+        }
+    }
+    fn in_lease(&self) {
+        assert!(
+            self.leased.load(Ordering::SeqCst),
+            "consumer accessed native authority outside lease"
+        );
+    }
+}
+struct Lease(Arc<AtomicBool>);
+impl Drop for Lease {
+    fn drop(&mut self) {
+        self.0.store(false, Ordering::SeqCst);
+    }
+}
+fn window() -> WindowInfo {
+    serde_json::from_value(json!({"id":"w-7","pid":42,"process_instance":"A:1","title":"Synthetic","app_name":"Fixture","bounds":{"x":0.0,"y":0.0,"width":100.0,"height":100.0},"is_focused":true,"visible":true})).unwrap()
+}
+impl crate::adapter::ActionOps for World {}
+impl crate::adapter::ObservationOps for World {
+    fn list_windows(
+        &self,
+        _filter: &crate::WindowFilter,
+        _deadline: Deadline,
+    ) -> Result<Vec<WindowInfo>, AdapterError> {
+        Ok(vec![self.window.lock().unwrap().clone()])
+    }
+    fn list_apps(&self, _deadline: Deadline) -> Result<Vec<crate::AppInfo>, AdapterError> {
+        let w = self.window.lock().unwrap();
+        Ok(vec![crate::AppInfo {
+            name: w.app.clone(),
+            pid: w.pid,
+            bundle_id: None,
+            process_instance: w.process_instance.clone(),
+            presentation: None,
+        }])
+    }
+    fn get_tree(
+        &self,
+        _window: &WindowInfo,
+        _options: &crate::TreeOptions,
+        _deadline: Deadline,
+    ) -> Result<crate::AccessibilityNode, AdapterError> {
+        self.in_lease();
+        let mut tree = crate::adapter::minimal_accessibility_node("window", "Synthetic");
+        if matches!(self.change, Change::SecureBeforeFocus)
+            || matches!(self.change, Change::SecureAfterFocus)
+                && self.focuses.load(Ordering::SeqCst) > 0
+        {
+            let mut child = crate::adapter::minimal_accessibility_node("textfield", "Password");
+            child.presentation.states = vec!["secure".into(), "focused".into()];
+            child.presentation.bounds = self.window.lock().unwrap().bounds;
+            tree.children.push(child);
+        }
+        Ok(tree)
+    }
+}
+impl crate::adapter::SystemOps for World {
+    fn press_key_for_app(
+        &self,
+        _process: crate::ProcessIdentity,
+        _combo: &crate::KeyCombo,
+        _policy: crate::InteractionPolicy,
+        _lease: &InteractionLease,
+    ) -> Result<crate::ActionResult, AdapterError> {
+        self.in_lease();
+        self.inputs.fetch_add(1, Ordering::SeqCst);
+        Ok(crate::ActionResult::delivered_unverified("press_key"))
+    }
+    fn acquire_interaction_lease(
+        &self,
+        deadline: Deadline,
+    ) -> Result<InteractionLease, AdapterError> {
+        assert!(!self.leased.swap(true, Ordering::SeqCst));
+        if matches!(self.change, Change::ReusedAtLease) {
+            let mut w = self.window.lock().unwrap();
+            w.pid = crate::ProcessId::new(99);
+            w.process_instance = Some("B:2".into());
+        }
+        InteractionLease::guarded(deadline, Lease(self.leased.clone()))
+    }
+    fn resolve_window_strict(
+        &self,
+        _expected: &WindowInfo,
+        _deadline: Deadline,
+    ) -> Result<WindowInfo, AdapterError> {
+        self.in_lease();
+        if matches!(self.change, Change::ResolveAfterFocus)
