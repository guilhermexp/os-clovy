+pub(crate) struct NativeOwner(Option<Owner<NativeState>>);
+impl NativeOwner {
+    pub(crate) fn begin(keys: Vec<u16>) -> Result<Self, AdapterError> {
+        ensure_interactive_desktop()?;
+        if !agent_desktop_core::commands::clovy_cancel::supervised() {
+            return Ok(Self(None));
+        }
+        Owner::begin(NativeState::new(), keys).map(|owner| Self(Some(owner)))
+    }
+    /// Call only after every inner button/modifier/key release guard dropped.
+    pub(crate) fn finish(self, result: Result<(), AdapterError>) -> Result<(), AdapterError> {
+        match self.0 {
+            Some(owner) => owner.finish(
+                result,
+                agent_desktop_core::commands::clovy_cancel::acknowledge_release,
+            ),
+            None => result,
+        }
+    }
+}
+struct NativeState {
+    #[cfg(target_os = "windows")]
+    input: Option<DesktopHandle>,
+}
+impl NativeState {
+    fn new() -> Self {
+        Self {
+            #[cfg(target_os = "windows")]
+            input: None,
+        }
+    }
+}
+#[cfg(target_os = "windows")]
+struct DesktopHandle(*mut std::ffi::c_void);
+#[cfg(target_os = "windows")]
+impl DesktopHandle {
+    fn open() -> Result<Self, AdapterError> {
+        #[link(name = "user32")]
+        unsafe extern "system" {
+            fn OpenInputDesktop(flags: u32, inherit: i32, access: u32) -> *mut std::ffi::c_void;
+        }
+        const DESKTOP_READOBJECTS: u32 = 0x0001;
+        const DESKTOP_HOOKCONTROL: u32 = 0x0008;
+        let handle = unsafe { OpenInputDesktop(0, 0, DESKTOP_READOBJECTS | DESKTOP_HOOKCONTROL) };
+        if handle.is_null() {
+            Err(context_unavailable(
+                "The active input desktop cannot be inspected with hook access",
+            ))
+        } else {
+            Ok(Self(handle))
+        }
+    }
+}
+#[cfg(target_os = "windows")]
+impl Drop for DesktopHandle {
+    fn drop(&mut self) {
+        #[link(name = "user32")]
+        unsafe extern "system" {
+            fn CloseDesktop(desktop: *mut std::ffi::c_void) -> i32;
+        }
+        unsafe {
+            CloseDesktop(self.0);
+        }
+    }
+}
+#[cfg(target_os = "windows")]
+impl Observations for NativeState {
+    type Desktop = (String, String);
+    fn desktop(&mut self) -> Result<Self::Desktop, AdapterError> {
+        use std::ffi::c_void;
+        #[link(name = "user32")]
+        unsafe extern "system" {
+            fn GetThreadDesktop(thread: u32) -> *mut c_void;
+            fn GetProcessWindowStation() -> *mut c_void;
+            fn GetUserObjectInformationW(
+                object: *mut c_void,
+                index: i32,
+                data: *mut c_void,
+                length: u32,
+                needed: *mut u32,
+            ) -> i32;
+        }
+        #[link(name = "kernel32")]
+        unsafe extern "system" {
+            fn GetCurrentThreadId() -> u32;
+        }
+        fn name(object: *mut c_void) -> Result<String, AdapterError> {
+            if object.is_null() {
+                return Err(context_unavailable("The input desktop is unavailable"));
+            }
+            let mut needed = 0u32;
+            unsafe {
+                GetUserObjectInformationW(object, 2, std::ptr::null_mut(), 0, &mut needed);
+            }
+            if !(2..=8192).contains(&needed) || needed % 2 != 0 {
+                return Err(context_unavailable(
+                    "The input desktop identity is unavailable",
+                ));
+            }
+            let mut data = vec![0u16; needed as usize / 2];
+            if unsafe {
+                GetUserObjectInformationW(object, 2, data.as_mut_ptr().cast(), needed, &mut needed)
+            } == 0
+            {
+                return Err(context_unavailable(
+                    "The input desktop identity is unavailable",
+                ));
+            }
+            let end = data.iter().position(|c| *c == 0).unwrap_or(data.len());
+            String::from_utf16(&data[..end])
+                .map_err(|_| context_unavailable("The input desktop identity is invalid"))
+        }
+        if self.input.is_none() {
+            self.input = Some(DesktopHandle::open()?);
+        }
+        let active = DesktopHandle::open()?;
+        let input_name = name(active.0)?;
+        let retained = self
+            .input
+            .as_ref()
+            .ok_or_else(|| context_unavailable("The owned input desktop is unavailable"))?;
+        if name(retained.0)? != input_name {
+            return Err(context_unavailable("The active input desktop changed"));
+        }
+        let thread_name = name(unsafe { GetThreadDesktop(GetCurrentThreadId()) })?;
+        let station = name(unsafe { GetProcessWindowStation() })?;
+        if !station.eq_ignore_ascii_case("WinSta0")
+            || !input_name.eq_ignore_ascii_case("Default")
+            || thread_name != input_name
+        {
+            return Err(context_unavailable(
+                "Native input requires this process's active interactive desktop",
+            ));
+        }
+        foreground_observation()?;
+        Ok((station, input_name))
+    }
+    fn down(&mut self, key: u16) -> Result<bool, AdapterError> {
+        #[link(name = "user32")]
+        unsafe extern "system" {
+            fn GetAsyncKeyState(key: i32) -> i16;
+        }
+        let before = foreground_observation()?;
+        let down = (unsafe { GetAsyncKeyState(i32::from(key)) }) & i16::MIN != 0;
+        if foreground_observation()? != before {
+            return Err(context_unavailable(
+                "The foreground changed during key-state observation",
+            ));
+        }
+        Ok(down)
+    }
+}
+#[cfg(target_os = "windows")]
+fn foreground_observation() -> Result<(usize, u32, String), AdapterError> {
+    use std::ffi::c_void;
+    #[link(name = "user32")]
+    unsafe extern "system" {
+        fn GetForegroundWindow() -> *mut c_void;
+        fn GetWindowThreadProcessId(window: *mut c_void, pid: *mut u32) -> u32;
+    }
+    let foreground = unsafe { GetForegroundWindow() };
+    let mut pid = 0u32;
+    if foreground.is_null()
+        || unsafe { GetWindowThreadProcessId(foreground, &mut pid) } == 0
+        || pid == 0
+    {
+        return Err(context_unavailable(
+            "The foreground process identity is unavailable",
+        ));
+    }
+    let process = agent_desktop_core::ProcessId::new(pid);
+    let caller = super::elevation::current_process_integrity_rid()
+        .ok_or_else(|| context_unavailable("The native input caller integrity is unknown"))?;
+    let target = super::elevation::process_integrity_rid(process)
+        .ok_or_else(|| context_unavailable("The foreground integrity is unknown"))?;
+    if target > caller {
+        return Err(context_unavailable(
+            "The foreground integrity prevents reliable key-state observation",
+        ));
+    }
+    let token = crate::system::process_identity::token_for_pid(process)
+        .map_err(|_| context_unavailable("The foreground process generation cannot be inspected"))?
+        .ok_or_else(|| context_unavailable("The foreground process generation is unknown"))?;
+    let mut after = 0u32;
+    if unsafe { GetForegroundWindow() } != foreground
+        || unsafe { GetWindowThreadProcessId(foreground, &mut after) } == 0
+        || after != pid
+    {
+        return Err(context_unavailable(
+            "The foreground process changed during input observation",
+        ));
+    }
+    Ok((foreground as usize, pid, token))
+}
+#[cfg(not(target_os = "windows"))]
+impl Observations for NativeState {
+    type Desktop = ();
+    fn desktop(&mut self) -> Result<(), AdapterError> {
+        Err(unsent("Native Windows input is unavailable"))
+    }
+    fn down(&mut self, _key: u16) -> Result<bool, AdapterError> {
+        Err(unsent("Native Windows input is unavailable"))
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        cell::{Cell, RefCell},
+        rc::Rc,
+    };
+    struct Read {
+        held: Rc<RefCell<Vec<u16>>>,
+        fail: Rc<Cell<bool>>,
+        desktop: Rc<Cell<u8>>,
+        delay_ms: Rc<Cell<u64>>,
+    }
+    impl Observations for Read {
+        type Desktop = u8;
+        fn desktop(&mut self) -> Result<u8, AdapterError> {
+            std::thread::sleep(Duration::from_millis(self.delay_ms.get()));
+            if self.fail.get() {
+                Err(unsent("query failed"))
+            } else {
+                Ok(self.desktop.get())
+            }
+        }
+        fn down(&mut self, key: u16) -> Result<bool, AdapterError> {
+            Ok(self.held.borrow().contains(&key))
+        }
+    }
+    fn state() -> (Read, Rc<RefCell<Vec<u16>>>, Rc<Cell<bool>>, Rc<Cell<u8>>) {
+        let held = Rc::new(RefCell::new(vec![]));
+        let fail = Rc::new(Cell::new(false));
+        let desktop = Rc::new(Cell::new(1));
+        (
+            Read {
+                held: held.clone(),
+                fail: fail.clone(),
+                desktop: desktop.clone(),
+                delay_ms: Rc::new(Cell::new(0)),
+            },
+            held,
+            fail,
+            desktop,
+        )
+    }
+    #[test]
+    fn preheld_user_key_is_never_borrowed_or_released() {
+        let (read, held, _, _) = state();
+        held.borrow_mut().push(0x10);
+        assert!(Owner::begin(read, vec![0x10, 1]).is_err());
+        assert_eq!(*held.borrow(), [0x10]);
+    }
+    #[test]
+    fn only_released_owned_keys_can_acknowledge_and_unknown_keeps_unsafe_receipt() {
+        for failed_query in [false, true] {
+            let (read, held, fail, _) = state();
+            let owner = Owner::begin(read, vec![0x10, 0x11, 1]).unwrap();
+            held.borrow_mut().extend([0x10, 0x11, 1]);
+            // The inner guards, not this observing owner, release only keys
+            // they actually armed before returning to finish.
+            held.borrow_mut().clear();
+            fail.set(failed_query);
+            let ack = Cell::new(false);
+            let result = owner.finish(Ok(()), |released| ack.set(released));
+            assert_eq!(ack.get(), !failed_query);
+            if failed_query {
+                assert_eq!(
+                    result.unwrap_err().disposition,
+                    DeliverySemantics::uncertain()
+                );
+            } else {
+                result.unwrap();
+            }
+        }
+    }
+    #[test]
+    fn changed_desktop_or_held_key_never_acknowledges() {
+        for change_desktop in [false, true] {
+            let (read, held, _, desktop) = state();
+            let owner = Owner::begin(read, vec![0x12]).unwrap();
+            if change_desktop {
+                desktop.set(2);
+            } else {
+                held.borrow_mut().push(0x12);
+            }
+            let ack = Cell::new(false);
+            let result = owner.finish(Ok(()), |released| ack.set(released));
+            assert!(!ack.get());
+            assert_eq!(
+                result.unwrap_err().disposition,
+                DeliverySemantics::uncertain()
+            );
+        }
+    }
+    #[test]
+    fn an_unposted_planned_key_pressed_by_the_user_is_never_released() {
+        let (read, held, _, _) = state();
+        let owner = Owner::begin(read, vec![0x11, 0x41]).unwrap();
+        // Ctrl was posted and its actual inner guard released it. Stop
+        // prevented A from being posted; a concurrent human then pressed A.
+        held.borrow_mut().push(0x41);
+        let ack = Cell::new(false);
+        let outcome = owner.finish(Err(unsent("Stopped before A")), |released| {
+            ack.set(released)
+        });
+        assert!(!ack.get());
+        assert_eq!(*held.borrow(), [0x41]);
+        assert_eq!(
+            outcome.unwrap_err().disposition,
+            DeliverySemantics::uncertain()
+        );
+    }
+    #[test]
+    fn an_expired_native_observation_never_acknowledges_even_if_it_returns_clear() {
+        struct SlowSecond(u8);
+        impl Observations for SlowSecond {
+            type Desktop = u8;
+            fn desktop(&mut self) -> Result<u8, AdapterError> {
+                self.0 += 1;
+                // Begin uses reads1-2; first clear observation uses3-4.
+                // Only the second clear observation blocks past the budget.
+                if self.0 >= 5 {
+                    std::thread::sleep(Duration::from_millis(25));
+                }
+                Ok(1)
+            }
+            fn down(&mut self, _key: u16) -> Result<bool, AdapterError> {
+                Ok(false)
+            }
+        }
+        let owner = Owner::begin(SlowSecond(0), vec![0x11]).unwrap();
+        let ack = Cell::new(false);
+        let result = owner.finish(Ok(()), |released| ack.set(released));
+        assert!(!ack.get());
+        assert_eq!(
+            result.unwrap_err().disposition,
+            DeliverySemantics::uncertain()
+        );
+    }
+    #[test]
+    fn desktop_loss_preserves_domain_and_prior_delivery_at_the_outer_error() {
+        let before = with_desktop_domain(unsent("Locked"), false);
+        assert_eq!(before.disposition, DeliverySemantics::not_delivered());
+        assert_eq!(
+            before.details.as_ref().unwrap()["clovy_code"],
+            "computer_use_desktop_unavailable"
+        );
+        let scalar = with_desktop_domain(
+            unsent("Locked").with_details(serde_json::json!("native cause")),
+            false,
+        );
+        assert_eq!(
+            scalar.details.as_ref().unwrap()["clovy_code"],
+            "computer_use_desktop_unavailable"
+        );
+        assert_eq!(
+            scalar.details.as_ref().unwrap()["native_details"],
+            "native cause"
+        );
+        let after = with_desktop_domain(unsent("Locked"), true);
+        assert_eq!(after.disposition, DeliverySemantics::uncertain());
+        let unknown = with_desktop_domain(
+            unsent("Locked").with_disposition(DeliverySemantics::unknown()),
+            true,
+        );
+        assert_eq!(unknown.disposition, DeliverySemantics::uncertain());
+        let prior = agent_desktop_core::ActionResult::delivered_unverified("click");
+        let error = settle_action_result(Ok(prior), true, true).unwrap_err();
+        assert_eq!(error.disposition, DeliverySemantics::delivered_unverified());
+        assert_eq!(
+            error.details.as_ref().unwrap()["clovy_code"],
+            "computer_use_desktop_unavailable"
+        );
+        assert!(
+            error
+                .details
+                .as_ref()
+                .unwrap()
+                .get("prior_action_result")
+                .is_some()
+        );
+    }
+}
