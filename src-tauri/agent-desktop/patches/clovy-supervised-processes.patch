+fn copy_identity_text(
+    pointer: *const std::ffi::c_char,
+    length: usize,
+    field: &str,
+) -> Result<String, AdapterError> {
+    if pointer.is_null() || length == 0 || length > 32 * 1024 {
+        return Err(AdapterError::internal(format!(
+            "Native launch {field} is unavailable"
+        )));
+    }
+    let bytes = unsafe { std::slice::from_raw_parts(pointer.cast::<u8>(), length) };
+    if bytes.contains(&0) {
+        return Err(AdapterError::internal(format!(
+            "Native launch {field} is invalid"
+        )));
+    }
+    String::from_utf8(bytes.to_vec())
+        .map_err(|_| AdapterError::internal(format!("Native launch {field} is not UTF-8")))
