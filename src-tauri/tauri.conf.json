{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clovy",
  "version": "0.1.0",
  "identifier": "dev.guilhermexp.clovy",
  "build": {
    "beforeDevCommand": "node ./scripts/tauri-before-dev.mjs",
    "beforeBuildCommand": "pnpm run agent-runtime:build && node ./scripts/build-agent-runtime.mjs && pnpm run extension:build && node ./scripts/validate-extension-id.mjs && pnpm run computer-use:prepare -- --release && pnpm run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Clovy",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      },
      {
        "label": "hud",
        "url": "/hud.html",
        "title": "Clovy Dictation",
        "width": 124,
        "height": 32,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "agent-hud",
        "url": "/agent-hud.html",
        "title": "Clovy Agents",
        "width": 240,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focusable": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "meeting-hud",
        "url": "/meeting-hud.html",
        "title": "Clovy Recording",
        "width": 76,
        "height": 76,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'sha256-5zseCXEQXMrhVnLDc5/8D6srY3KbB1TDtKXlkC9HSao='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; media-src 'self' asset: data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/clovy-dictation-*.m4a",
          "$TEMP/clovy-dictation-*.wav"
        ]
      },
      "capabilities": [
        "main",
        "hud",
        "agent-hud",
        "meeting-hud"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "clovy"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "clovy"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDODFEM0NBQjZENzU4MzYKUldRMldOZTJ5dE9CZkZHa0NQeU0vdW9BNmRVZnErcXZsTytXZXVwYzkvVFNmT0xzN3VmdlVaQ3EK",
      "endpoints": [
        "https://github.com/guilhermexp/os-clovy/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../extension/dist": "native/extension",
      "resources/agent-skills": "native/agent-skills"
    }
  }
}
