{
  "productName": "Clovy",
  "bundle": {
    "publisher": "guilhermexp",
    "targets": ["nsis"],
    "resources": {
      "../extension/dist": "native/extension",
      "resources/agent-skills": "native/agent-skills",
      "native/bin/clovy-dictation-helper.exe": "native/bin/clovy-dictation-helper.exe",
      "../.tauri-helper/computer-use": "native/bin/computer-use"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-NonInteractive",
          "-File",
          "../scripts/windows-sign.ps1",
          "-TargetPath",
          "%1"
        ]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
