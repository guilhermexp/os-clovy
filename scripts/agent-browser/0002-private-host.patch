@@ -636,0 +637,45 @@ impl BrowserManager {
+    #[cfg(feature = "clovy-private")]
+    pub fn select_private_tab(&mut self, tab_id: u32) -> Result<(), String> {
+        let index = self
+            .pages
+            .iter()
+            .position(|p| p.tab_id == tab_id)
+            .ok_or("tab_gone")?;
+        self.active_page_index = index;
+        self.bind_active_target();
+        Ok(())
+    }
+
+    #[cfg(feature = "clovy-private")]
+    pub async fn from_private_pipe(client: CdpClient) -> Result<Self, String> {
+        let mut manager = Self {
+            client: Arc::new(client),
+            browser_process: None,
+            ws_url: String::new(),
+            pages: Vec::new(),
+            active_page_index: 0,
+            default_timeout_ms: 15_000,
+            download_path: None,
+            ignore_https_errors: false,
+            visited_origins: HashSet::new(),
+            next_tab_id: 1,
+            direct_page: false,
+            pin_tab: true,
+            bound_target_id: None,
+            bound_target_gone: None,
+            wedge_suspect: None,
+            headless: true,
+        };
+        manager
+            .client
+            .send_command(
+                "Browser.setDownloadBehavior",
+                Some(json!({"behavior":"deny","eventsEnabled":false})),
+                None,
+            )
+            .await?;
+        manager.tab_new(None, None).await?;
+        manager.set_pin_tab(true);
+        Ok(manager)
+    }
