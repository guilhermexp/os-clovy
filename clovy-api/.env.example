# Clovy API local env. Copy to clovy-api/.env and fill in real values.
# This file lives next to the Clovy API workspace so service-only secrets stay
# isolated from the Tauri client's env at the repo root.
#
# Figment maps CLOVY__SECTION__FIELD env vars onto AppConfig fields. The
# double underscore (__) is the section separator — single underscores in
# field names stay literal (e.g. BEARER_TOKEN -> bearer_token).

# --- Local mode -------------------------------------------------------------
# Clovy API runs only in local mode: one local bearer token, no accounts and
# no billing. Keep the bearer token in sync with OS_CLOVY_LOCAL_DEV_BEARER_TOKEN
# in the root .env file.
#
# WARNING: the default bearer token below is a publicly known placeholder. That
# is safe only while CLOVY__SERVER__HOST stays on loopback (127.0.0.0/8 or ::1).
# If you rebind the server to a non-loopback address, anyone who can reach the
# port can authenticate with this token (local mode never charges), and
# Clovy API refuses to start in that combination. Set a random token instead,
# e.g. `openssl rand -hex 32`, and keep it in sync with the root .env.
CLOVY__SERVER__HOST=127.0.0.1
# Clovy refreshes OpenRouter's model catalog in-process at this interval, so
# new upstream models become selectable without restarting the API. Default: 300.
# CLOVY__SERVER__MODEL_CATALOG_REFRESH_SECS=300
CLOVY__LOCAL_DEV__BEARER_TOKEN=local-dev-token
CLOVY__LOCAL_DEV__USER_ID=usr_local_dev

# Flat credit Hold authorized for every metered action (transcribe, generate,
# dictate). Skips per-request estimation entirely — the duration probe and
# token pre-count are bypassed in favor of this single value. Trades a bigger
# Hold for not needing to support every audio format the helper might produce.
# Default: 250.
# CLOVY__OS_ACCOUNTS__FLAT_ESTIMATE_CREDITS=250

# --- Upstream providers -----------------------------------------------------
# Clovy's own service keys, one per capability: Groq for dictation and note
# transcription, OpenRouter for text (chat, notes, dictation cleanup), fal for
# images and video, Tavily for web search and fetch. A blank or placeholder
# key leaves its models listed: a request then needs the user's own key for that provider
# (sent by the desktop app) and fails with `<provider>_not_configured`
# without one. To use a compatible provider, set the matching BASE_URL and add
# pricing entries in config.toml for the model ids you want to expose.
CLOVY__UPSTREAMS__GROQ__API_KEY=GROQ_API_KEY_REPLACE_ME
# CLOVY__UPSTREAMS__GROQ__BASE_URL=https://api.groq.com/openai/v1
CLOVY__UPSTREAMS__OPENROUTER__API_KEY=OPENROUTER_API_KEY_REPLACE_ME
# CLOVY__UPSTREAMS__OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
CLOVY__UPSTREAMS__FAL__API_KEY=FAL_API_KEY_REPLACE_ME
# CLOVY__UPSTREAMS__FAL__BASE_URL=https://queue.fal.run
CLOVY__UPSTREAMS__TAVILY__API_KEY=TAVILY_API_KEY_REPLACE_ME
# CLOVY__UPSTREAMS__TAVILY__BASE_URL=https://api.tavily.com

# --- Clovy Companion -------------------------------------------------------
# Without Postgres the relay keeps linked-device state only until restart.
# CLOVY__COMPANION__DATABASE_URL=postgres://...

# Optional content-free APNs background wakes. All five values are required
# to enable delivery; the .p8 key is server-only and may use literal newlines
# or escaped \n sequences. Use APNS_PRODUCTION=false for development builds.
# CLOVY__COMPANION__APNS_TEAM_ID=
# CLOVY__COMPANION__APNS_KEY_ID=
# CLOVY__COMPANION__APNS_PRIVATE_KEY_PEM=
# CLOVY__COMPANION__APNS_BUNDLE_ID=
# CLOVY__COMPANION__APNS_PRODUCTION=false
