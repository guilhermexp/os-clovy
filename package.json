{
  "name": "clovy",
  "version": "0.1.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:build:release-mac": "./scripts/build-macos-release.sh",
    "computer-use:prepare": "node scripts/prepare-cua-driver.mjs",
    "computer-use:self-test": "node scripts/computer-use-self-test.mjs",
    "computer-use:self-test:live": "node scripts/computer-use-self-test.mjs --live",
    "build": "tsc && vite build",
    "test": "vitest run --configLoader=runner",
    "test:coverage": "vitest run --configLoader=runner --coverage",
    "test:ui": "vitest run --configLoader=runner",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:rust:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --all-targets --html --output-dir src-tauri/target/llvm-cov/html",
    "version:bump": "node scripts/bump-version.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "extension:build": "pnpm --filter clovy-extension build",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension",
    "local-transcriber:prepare": "node scripts/prepare-local-transcriber.mjs",
    "local-transcriber:self-test": "node scripts/local-transcriber-self-test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2",
    "@tiptap/extension-mention": "3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/suggestion": "3.27.1",
    "asciify-engine": "4.29.0",
    "central-icons": "npm:@central-icons-react/round-outlined-radius-3-stroke-2@1.1.233",
    "central-icons-filled": "npm:@central-icons-react/round-filled-radius-3-stroke-2@1.1.241",
    "framer-motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "agentation": "^3.0.2",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
